<Window x:Class="HelmetDesk.StickyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HelmetDesk"
        Title="{Binding DisplayTitle}" Width="280" Height="300" MinWidth="200" MinHeight="140"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{StaticResource Surface}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Icon="Assets/icon.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
        <DockPanel>
            <!-- label color strip: fades to the new color when the label changes -->
            <Border DockPanel.Dock="Top" Height="4" local:Motion.Background="{Binding LabelBrush}"/>
            <DockPanel DockPanel.Dock="Top" Height="30" Margin="10,0,4,0">
                <!-- top right: only "open in Helmet Desk"; the other actions sit in the bottom bar -->
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Padding="5" Click="Open_Click" ToolTip="Abrir no Helmet Desk"
                        WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center">
                    <local:Icon Data="{StaticResource I.Open}" Width="14" Height="14"/>
                </Button>
                <!-- the label shows only as the color strip above; its name is not repeated here -->
                <TextBlock Text="{Binding KindName}" Style="{StaticResource Muted}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- bottom right: new / label / always on top / close -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,4">
                <Button Style="{StaticResource IconButton}" Padding="5" Click="New_Click" ToolTip="Nova nota na área de trabalho">
                    <local:Icon Data="{StaticResource I.Plus}" Width="14" Height="14"/>
                </Button>
                <Button x:Name="ColorBtn" Style="{StaticResource IconButton}" Padding="5" Click="Color_Click" ToolTip="Etiqueta de cor">
                    <local:Icon Data="{StaticResource I.Tag}" Width="14" Height="14"/>
                </Button>
                <ToggleButton x:Name="TopBtn" Style="{StaticResource ToggleIcon}" Padding="5" Click="Top_Click" ToolTip="Manter sempre visível (sobre as outras janelas)">
                    <local:Icon Data="{StaticResource I.Pin}" Width="14" Height="14"/>
                </ToggleButton>
                <Button Style="{StaticResource IconButton}" Padding="5" Click="Close_Click" ToolTip="Fechar widget (a nota continua salva)">
                    <local:Icon Data="{StaticResource I.X}" Width="14" Height="14"/>
                </Button>
            </StackPanel>

            <!-- opens upward, since the button is now at the bottom edge -->
            <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorBtn}" Placement="Top" StaysOpen="False" AllowsTransparency="True"
                   local:Motion.PopIn="True">
                <Border Background="{StaticResource Elevated}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="10,10,4,4" Margin="0,8,8,0">
                    <ListBox x:Name="LabelList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource SwatchItem}"
                             SelectedValuePath="Id" SelectedValue="{Binding LabelId}" Width="176" SelectionChanged="LabelList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Fill="{Binding Brush}" ToolTip="{Binding Name}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>

            <ScrollViewer x:Name="BodyScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,2,12,14">
                    <TextBox x:Name="TitleBox" Style="{StaticResource BareTextBox}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                             Tag="Título" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>

                    <StackPanel Visibility="{Binding IsTask, Converter={StaticResource Vis}}" Margin="0,8,0,0">
                        <CheckBox Style="{StaticResource TaskCheck}" IsChecked="{Binding Done}" Content="Concluída"/>
                    </StackPanel>

                    <WrapPanel Margin="0,12,0,0">
                        <Border Style="{StaticResource Pill}" Visibility="{Binding HasDate, Converter={StaticResource Vis}}" Margin="0,2,6,0">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{StaticResource I.Calendar}" Width="12" Height="12" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding DateText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Pill}" Visibility="{Binding HasEstimate, Converter={StaticResource Vis}}" Margin="0,2,6,0">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{StaticResource I.Clock}" Width="12" Height="12" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding EstimateDisplay}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <TextBox Style="{StaticResource BareTextBox}" Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                             TextWrapping="Wrap" Tag="Escreva aqui…" MinHeight="36" Margin="0,14,0,0" Foreground="{StaticResource Text}" SpellCheck.IsEnabled="False"/>

                    <ItemsControl ItemsSource="{Binding Checklist}" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="ci" Margin="0,2" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Done}" VerticalAlignment="Top" Margin="0,3,8,0"/>
                                    <TextBox x:Name="t" Grid.Column="1" Style="{StaticResource BareTextBox}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap" Padding="0,2" KeyDown="CheckText_KeyDown"/>
                                    <Button x:Name="rm" Grid.Column="2" Style="{StaticResource IconButton}" Padding="3" Click="RemoveCheck_Click" Visibility="Hidden" VerticalAlignment="Top">
                                        <local:Icon Data="{StaticResource I.X}" Width="12" Height="12"/>
                                    </Button>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="ci" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="rm" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                        <Setter TargetName="t" Property="TextDecorations" Value="Strikethrough"/>
                                        <Setter TargetName="t" Property="Foreground" Value="{StaticResource Text2}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,4,0,0">
                        <TextBox x:Name="NewCheck" Style="{StaticResource BareTextBox}" Tag="Adicionar item (Enter)" Padding="26,4,0,4" KeyDown="NewCheck_KeyDown"/>
                        <local:Icon Data="{StaticResource I.Square}" Foreground="{StaticResource Text2}" Width="16" Height="16"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.6"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
