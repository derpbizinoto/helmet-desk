<Application x:Class="HelmetDesk.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HelmetDesk"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- the theme (Themes/FrutigerAero.xaml or Themes/Legacy.xaml) is merged at startup by ThemeManager.Apply -->
            <local:VisConverter x:Key="Vis"/>
            <local:HexBrushConverter x:Key="HexBrush"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
