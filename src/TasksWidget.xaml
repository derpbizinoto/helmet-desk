<Window x:Class="HelmetDesk.TasksWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HelmetDesk"
        Title="Tarefas — Helmet Desk" Width="300" Height="380" MinWidth="220" MinHeight="180"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{StaticResource Surface}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Icon="Assets/icon.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="4" Background="{StaticResource Primary}"/>
            <DockPanel DockPanel.Dock="Top" Margin="14,6,4,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center">
                    <ToggleButton x:Name="TopBtn" Style="{StaticResource ToggleIcon}" Padding="5" Click="Top_Click" ToolTip="Manter sempre visível">
                        <local:Icon Data="{StaticResource I.Pin}" Width="14" Height="14"/>
                    </ToggleButton>
                    <Button Style="{StaticResource IconButton}" Padding="5" Click="Open_Click" ToolTip="Abrir no Helmet Desk">
                        <local:Icon Data="{StaticResource I.Open}" Width="14" Height="14"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Padding="5" Click="Close_Click" ToolTip="Fechar widget">
                        <local:Icon Data="{StaticResource I.X}" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Tarefas" FontWeight="Bold" FontSize="14"/>
                    <TextBlock x:Name="Meta" Style="{StaticResource Muted}" FontSize="11.5"/>
                </StackPanel>
            </DockPanel>

            <Grid DockPanel.Dock="Top" Margin="10,0,10,8">
                <TextBox x:Name="Quick" Tag="Nova tarefa para hoje (Enter)" Padding="30,6,10,6" KeyDown="Quick_KeyDown"/>
                <local:Icon Data="{StaticResource I.Plus}" Foreground="{StaticResource Accent}" Width="14" Height="14"
                            HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
            </Grid>

            <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10,0,10,10">
                    <ItemsControl x:Name="List">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="row" CornerRadius="8" Padding="8,6" local:Motion.Background="Transparent" Cursor="Hand" MouseLeftButtonDown="Row_MouseDown">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="cb" Style="{StaticResource TaskCheck}" IsChecked="{Binding Done}" VerticalAlignment="Top" Margin="0,-2,10,0"/>
                                        <Border Grid.Column="1" Width="3" CornerRadius="2" Background="{Binding LabelBrush}" Margin="0,1,8,1"/>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="t" Text="{Binding DisplayTitle}" TextWrapping="Wrap" FontWeight="Medium"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock x:Name="d" Text="{Binding DateText}" Style="{StaticResource Muted}" FontSize="11.5"/>
                                                <TextBlock Text="{Binding EstimateDisplay}" Style="{StaticResource Muted}" FontSize="11.5" Margin="8,0,0,0"
                                                           Visibility="{Binding HasEstimate, Converter={StaticResource Vis}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="row" Property="local:Motion.Background" Value="{StaticResource Elevated}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                        <Setter TargetName="d" Property="Foreground" Value="{StaticResource Danger}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                        <Setter TargetName="t" Property="TextDecorations" Value="Strikethrough"/>
                                        <Setter TargetName="t" Property="Foreground" Value="{StaticResource Text2}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="Empty" Text="Tudo em dia. Nenhuma tarefa pendente." Style="{StaticResource MutedItalic}" Margin="8,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
