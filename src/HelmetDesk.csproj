<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>HelmetDesk</AssemblyName>
    <RootNamespace>HelmetDesk</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Product>Helmet Desk</Product>
    <AssemblyTitle>Helmet Desk</AssemblyTitle>
    <Version>1.0.2</Version>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <!-- Windows x64 only, using the installed .NET runtime. Without this, publish copies SkiaSharp's natives for
         every platform (osx/arm64/x86) plus ~95 MB debug symbols each into app\runtimes (~330 MB). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Program.Main is the entry point (Velopack has to run first), so App.xaml is a Page and WPF generates no Main -->
    <StartupObject>HelmetDesk.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <!-- Developer tooling (the selftest, selftest-restart, snapshot and readme-shots command-line modes; Snapshots*.cs,
       ReadmeShots.cs): compiled only when DevTools is true, which is the default in Debug. Release leaves it out;
       -p:DevTools=true turns it on in any configuration. build-release.ps1 refuses a package that still contains it. -->
  <PropertyGroup>
    <DevTools Condition="'$(DevTools)' == '' and '$(Configuration)' == 'Debug'">true</DevTools>
    <DefineConstants Condition="'$(DevTools)' == 'true'">$(DefineConstants);DEVTOOLS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(DevTools)' != 'true'">
    <Compile Remove="Snapshots.cs;Snapshots.*.cs;ReadmeShots.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\logo.png" />
    <!-- Google Fonts (Geo + Roboto, SIL OFL 1.1), embedded so the app works offline. tools\baixar-fontes.ps1 refreshes them -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <!-- Lottie animations: embedded, but only read when an animation is first shown -->
    <Resource Include="Assets\Animations\*.lottie;Assets\Animations\*.json" />
    <!-- Sound effects (Kenney Interface Sounds, CC0): embedded and read by SoundService on a background thread -->
    <EmbeddedResource Include="Assets\Sounds\*.wav" LogicalName="Sounds.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="SkiaSharp.Skottie" Version="4.156.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\HelmetDesk.Core.csproj" />
  </ItemGroup>

  <!-- SkiaSharp ships a ~97 MB native debug symbol file; the app doesn't need it -->
  <Target Name="DropNativePdb" AfterTargets="Publish">
    <Delete Files="$(PublishDir)libSkiaSharp.pdb" />
  </Target>

</Project>
