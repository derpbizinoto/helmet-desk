<Window x:Class="HelmetDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:HelmetDesk"
        Title="Helmet Desk" Width="1200" Height="780" MinWidth="900" MinHeight="580"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFontFamily}" FontSize="13"
        Icon="Assets/icon.ico" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- layout styles (EditButton, PillIcon, DatePill, GroupToggle, SettingTitle, SettingRow, PropRow, PropLabel)
             live in Themes/Screens.xaml; the templates below stay here because they call this window's handlers -->

        <!-- meta pills shared by cards and rows -->
        <DataTemplate x:Key="MetaPills">
            <WrapPanel>
                <Border Style="{StaticResource DatePill}" Visibility="{Binding HasDate, Converter={StaticResource Vis}}" Margin="0,4,6,0">
                    <StackPanel Orientation="Horizontal">
                        <local:Icon Data="{StaticResource I.Calendar}" Style="{StaticResource PillIcon}"/>
                        <TextBlock Text="{Binding DateText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Pill}" Visibility="{Binding HasEstimate, Converter={StaticResource Vis}}" Margin="0,4,6,0" ToolTip="{local:Tr 'Tempo estimado'}">
                    <StackPanel Orientation="Horizontal">
                        <local:Icon Data="{StaticResource I.Clock}" Style="{StaticResource PillIcon}"/>
                        <TextBlock Text="{Binding EstimateDisplay}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Pill}" Visibility="{Binding HasChecklist, Converter={StaticResource Vis}}" Margin="0,4,6,0" ToolTip="{local:Tr 'Checklist'}">
                    <StackPanel Orientation="Horizontal">
                        <local:Icon Data="{StaticResource I.Tasks}" Style="{StaticResource PillIcon}"/>
                        <TextBlock Text="{Binding ChecklistText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Pill}" Visibility="{Binding HasPriority, Converter={StaticResource Vis}}" Margin="0,4,6,0" ToolTip="{local:Tr 'Prioridade'}">
                    <StackPanel Orientation="Horizontal">
                        <local:Icon Data="{StaticResource I.Flag}" Style="{StaticResource PillIcon}" Foreground="{Binding PriorityBrush}"/>
                        <TextBlock Text="{Binding PriorityText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Pill}" Margin="0,4,6,0" Visibility="{Binding LabelName, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{Binding LabelBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LabelName}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </DataTemplate>

        <!-- ===== Note card ===== -->
        <DataTemplate x:Key="NoteCard">
            <Border x:Name="card" Width="252" Margin="0,0,12,12" Background="{StaticResource RowFill}"
                    local:Motion.BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Cursor="Hand"
                    MouseLeftButtonUp="Card_Click">
                <Grid>
                    <Border Height="4" VerticalAlignment="Top" Background="{Binding LabelBrush}" CornerRadius="9,9,0,0"/>
                    <!-- header on top, pills + edit pinned to the bottom edge (cards in a row share the tallest height) -->
                    <DockPanel Margin="16,14,10,14" LastChildFill="True">
                        <DockPanel DockPanel.Dock="Top">
                            <StackPanel x:Name="actions" DockPanel.Dock="Right" Orientation="Horizontal" Opacity="0" Margin="4,-2,0,0">
                                <Button Style="{StaticResource IconButton}" Click="PinWidget_Click" ToolTip="{local:Tr 'Fixar na área de trabalho'}">
                                    <local:Icon Data="{StaticResource I.Pin}" Width="14" Height="14"/>
                                </Button>
                                <Button Style="{StaticResource DangerGhost}" Padding="6" Click="Delete_Click" ToolTip="{local:Tr 'Excluir'}">
                                    <local:Icon Data="{StaticResource I.Trash}" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="14.5" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="0,2,0,0"/>
                        </DockPanel>
                        <DockPanel x:Name="footer" DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button x:Name="edit" DockPanel.Dock="Right" Style="{StaticResource EditButton}" Click="EditItem_Click" Margin="6,0,-2,-4" Opacity="0">
                                <local:Icon Data="{StaticResource I.Edit}" Width="14" Height="14"/>
                            </Button>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource MetaPills}" VerticalAlignment="Bottom"/>
                        </DockPanel>
                        <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="{Binding Preview}" Foreground="{StaticResource Text2}" TextWrapping="Wrap" MaxHeight="112"
                                   TextTrimming="CharacterEllipsis" Margin="0,8,6,0" LineHeight="19"
                                   Visibility="{Binding HasPreview, Converter={StaticResource Vis}}"/>
                        <ItemsControl ItemsSource="{Binding Checklist}" Margin="0,8,6,0" MaxHeight="128" ClipToBounds="True"
                                      Visibility="{Binding HasChecklist, Converter={StaticResource Vis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Done}" Margin="0,3" VerticalContentAlignment="Top">
                                        <TextBlock x:Name="t" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" Margin="0,1,0,0"/>
                                    </CheckBox>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Done}" Value="True">
                                            <Setter TargetName="t" Property="TextDecorations" Value="Strikethrough"/>
                                            <Setter TargetName="t" Property="Foreground" Value="{StaticResource Text2}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="actions" Property="Opacity" Value="1"/>
                    <Setter TargetName="edit" Property="Opacity" Value="1"/>
                    <Setter TargetName="card" Property="local:Motion.BorderBrush" Value="{StaticResource HoverLine}"/>
                </Trigger>
                <Trigger SourceName="card" Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="actions" Property="Opacity" Value="1"/>
                    <Setter TargetName="edit" Property="Opacity" Value="1"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Item row (tasks; also notes in day lists) ===== -->
        <DataTemplate x:Key="ItemRow">
            <Border x:Name="row" Background="{StaticResource RowFill}" local:Motion.BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="10" Padding="12,9,8,9" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonUp="Card_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- fixed width so the task ring and the note icon share one centre line -->
                    <Grid Width="24" Margin="0,0,12,0" VerticalAlignment="Center">
                        <CheckBox x:Name="cb" Style="{StaticResource TaskCheck}" IsChecked="{Binding Done}"
                                  Visibility="{Binding IsTask, Converter={StaticResource Vis}}" ToolTip="{local:Tr 'Concluir'}"/>
                        <local:Icon Data="{StaticResource I.Note}" Foreground="{StaticResource Text2}" Width="18" Height="18" HorizontalAlignment="Center"
                                    Visibility="{Binding IsNote, Converter={StaticResource Vis}}"/>
                    </Grid>
                    <Border Grid.Column="1" Width="3" CornerRadius="2" Background="{Binding LabelBrush}" Margin="0,1,12,1"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="title" Text="{Binding DisplayTitle}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource MetaPills}"/>
                    </StackPanel>
                    <!-- pin · delete · edit, side by side; shown on hover (or when one of them has keyboard focus) -->
                    <StackPanel x:Name="actions" Grid.Column="3" Orientation="Horizontal" Opacity="0" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button Style="{StaticResource IconButton}" Click="PinWidget_Click" ToolTip="{local:Tr 'Fixar na área de trabalho'}">
                            <local:Icon Data="{StaticResource I.Pin}" Width="14" Height="14"/>
                        </Button>
                        <Button Style="{StaticResource DangerGhost}" Padding="6" Click="Delete_Click" ToolTip="{local:Tr 'Excluir'}">
                            <local:Icon Data="{StaticResource I.Trash}" Width="14" Height="14"/>
                        </Button>
                        <Button Style="{StaticResource EditButton}" Click="EditItem_Click" VerticalAlignment="Center">
                            <local:Icon Data="{StaticResource I.Edit}" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="actions" Property="Opacity" Value="1"/>
                    <Setter TargetName="row" Property="local:Motion.BorderBrush" Value="{StaticResource HoverLine}"/>
                </Trigger>
                <Trigger SourceName="row" Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="actions" Property="Opacity" Value="1"/>
                </Trigger>
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter TargetName="title" Property="TextDecorations" Value="Strikethrough"/>
                    <Setter TargetName="title" Property="Foreground" Value="{StaticResource Text2}"/>
                    <Setter TargetName="row" Property="Opacity" Value="0.7"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Groups ===== -->
        <DataTemplate x:Key="GroupHeader">
            <Button Style="{StaticResource GroupToggle}" Click="GroupToggle_Click">
                <StackPanel Orientation="Horizontal">
                    <local:Icon x:Name="chev" Data="{StaticResource I.ChevronDown}" Width="14" Height="14" Margin="0,0,8,0"
                                Foreground="{StaticResource Text2}" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Collapsed}" Value="True">
                    <Setter TargetName="chev" Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="-90"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="NoteGroup">
            <StackPanel Margin="0,0,0,18">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource GroupHeader}"/>
                <ItemsControl x:Name="items" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource NoteCard}"
                              Visibility="{Binding Collapsed, Converter={StaticResource Vis}, ConverterParameter=not}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="RowGroup">
            <StackPanel Margin="0,0,0,18">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource GroupHeader}"/>
                <ItemsControl x:Name="items" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ItemRow}"
                              Visibility="{Binding Collapsed, Converter={StaticResource Vis}, ConverterParameter=not}"/>
            </StackPanel>
        </DataTemplate>

    </Window.Resources>

    <Border x:Name="Root">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- sidebar: width set in code (resizable when open, icons-only when collapsed) -->
                <ColumnDefinition x:Name="SideCol" Width="228" MinWidth="180" MaxWidth="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- theme backdrop (Violet Aero: twilight gradient + aurora + title glass strip; classic: nothing) -->
            <ContentControl Grid.ColumnSpan="2" Style="{StaticResource AppBackdrop}"/>
            <!-- theme glass behind the sidebar (classic: nothing) -->
            <ContentControl Style="{StaticResource SidebarGlass}"/>

            <!-- ================= Sidebar ================= -->
            <!-- Ui.WideOnly = shown only when the bar is open; Ui.CompactOnly = only when collapsed; Ui.CompactTip = tooltip when collapsed -->
            <Border x:Name="Sidebar" Style="{StaticResource SidebarPanel}">
                <DockPanel x:Name="SideDock" Margin="14,16,14,16">
                    <Grid x:Name="SideTop" DockPanel.Dock="Top" Margin="4,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" local:Ui.WideOnly="True" VerticalAlignment="Center">
                            <Image Source="Assets/logo.png" Height="21" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                            <TextBlock Text="HELMET DESK" Style="{StaticResource BrandText}" Margin="9,0,0,1" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button x:Name="SideToggle" Grid.Column="1" Style="{StaticResource IconButton}" Click="SideToggle_Click"
                                VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{local:Tr 'Recolher barra lateral (Ctrl+B)'}">
                            <local:Icon Data="{StaticResource I.PanelLeft}" Width="16" Height="16"/>
                        </Button>
                    </Grid>

                    <StackPanel DockPanel.Dock="Bottom">
                        <!-- 1. today's pending tasks -->
                        <Border Background="{StaticResource Bg}" CornerRadius="10" Padding="14,12" Margin="0,0,0,8" local:Ui.WideOnly="True">
                            <StackPanel>
                                <TextBlock Text="{local:Tr 'HOJE'}" Style="{StaticResource Overline}"/>
                                <TextBlock x:Name="SideTodayText" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="SideTodayHours" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="SideTodayCompact" Background="{StaticResource Bg}" CornerRadius="8" Height="36" Margin="0,0,0,8"
                                local:Ui.CompactOnly="True" Visibility="Collapsed">
                            <local:Icon Data="{StaticResource I.Check2}" Foreground="{StaticResource Text2}" Width="16" Height="16"/>
                        </Border>

                        <!-- 2. new sticky note -->
                        <Button x:Name="SideStickyRow" Style="{StaticResource SideRowButton}" Click="NewSticky_Click" Margin="0,0,0,8"
                                MinHeight="{Binding ActualHeight, ElementName=SideWidgetRow}"
                                ToolTip="{local:Tr 'Cria uma nota já fixada na área de trabalho'}" local:Ui.WideOnly="True">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{StaticResource I.Widget}" Foreground="{StaticResource Text2}" Width="15" Height="15" Margin="0,0,8,0"/>
                                <TextBlock Text="{local:Tr 'Nova nota adesiva'}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SideRowButton}" Click="NewSticky_Click" Padding="0" Height="36" Margin="0,0,0,8"
                                HorizontalContentAlignment="Center" local:Ui.Radius="8"
                                ToolTip="{local:Tr 'Nova nota adesiva'}" local:Ui.CompactOnly="True" Visibility="Collapsed">
                            <local:Icon Data="{StaticResource I.Widget}" Foreground="{StaticResource Text2}" Width="16" Height="16"/>
                        </Button>

                        <!-- 3. desktop tasks widget on/off (same setting as Configurações › Widget de tarefas) -->
                        <Border x:Name="SideWidgetRow" Background="{StaticResource Bg}" CornerRadius="10" Padding="14,9,10,9"
                                Cursor="Hand" MouseLeftButtonUp="SideWidgetRow_Click" local:Ui.WideOnly="True"
                                ToolTip="{local:Tr 'Mostra ou esconde a lista de tarefas na área de trabalho'}">
                            <DockPanel>
                                <CheckBox x:Name="SideWidgetSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                          IsChecked="{Binding TasksWidget, Mode=OneWay}" Click="TasksWidgetToggle_Click"
                                          AutomationProperties.Name="{local:Tr 'Widget de tarefas na área de trabalho'}"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <local:Icon Data="{StaticResource I.List}" Foreground="{StaticResource Text2}" Width="15" Height="15" Margin="0,0,8,0"/>
                                    <TextBlock Text="{local:Tr 'Widget de tarefas'}" FontSize="13"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ToggleButton x:Name="SideWidgetCompact" Style="{StaticResource ToggleIcon}" Height="36" HorizontalAlignment="Stretch"
                                      IsChecked="{Binding TasksWidget, Mode=OneWay}" Click="SideWidgetCompact_Click"
                                      local:Ui.CompactOnly="True" Visibility="Collapsed" ToolTip="{local:Tr 'Widget de tarefas (ligar/desligar)'}">
                            <local:Icon Data="{StaticResource I.List}"/>
                        </ToggleButton>
                    </StackPanel>

                    <Grid VerticalAlignment="Top">
                    <!-- highlight of the active item; slides between items (Motion.MoveTo) -->
                    <Border x:Name="NavMarker" VerticalAlignment="Top" Background="{StaticResource NavSelected}" CornerRadius="8"
                            IsHitTestVisible="False" Visibility="Collapsed"/>
                    <StackPanel x:Name="NavList">
                        <RadioButton x:Name="NavToday" Style="{StaticResource NavButton}" GroupName="nav" Tag="today" Checked="Nav_Checked" HorizontalContentAlignment="Stretch" local:Ui.CompactTip="Hoje">
                            <DockPanel>
                                <TextBlock x:Name="CountToday" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" local:Ui.WideOnly="True"/>
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Data="{StaticResource I.Home}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{local:Tr 'Hoje'}" local:Ui.WideOnly="True"/>
                                </StackPanel>
                            </DockPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavNotes" Style="{StaticResource NavButton}" GroupName="nav" Tag="notes" Checked="Nav_Checked" HorizontalContentAlignment="Stretch" local:Ui.CompactTip="Notas">
                            <DockPanel>
                                <TextBlock x:Name="CountNotes" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" local:Ui.WideOnly="True"/>
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Data="{StaticResource I.Note}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{local:Tr 'Notas'}" local:Ui.WideOnly="True"/>
                                </StackPanel>
                            </DockPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavTasks" Style="{StaticResource NavButton}" GroupName="nav" Tag="tasks" Checked="Nav_Checked" HorizontalContentAlignment="Stretch" local:Ui.CompactTip="Tarefas">
                            <DockPanel>
                                <TextBlock x:Name="CountTasks" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" local:Ui.WideOnly="True"/>
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Data="{StaticResource I.Tasks}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{local:Tr 'Tarefas'}" local:Ui.WideOnly="True"/>
                                </StackPanel>
                            </DockPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavCalendar" Style="{StaticResource NavButton}" GroupName="nav" Tag="calendar" Checked="Nav_Checked" HorizontalContentAlignment="Stretch" local:Ui.CompactTip="Calendário">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{StaticResource I.Calendar}" Margin="0,0,10,0"/>
                                <TextBlock Text="{local:Tr 'Calendário'}" local:Ui.WideOnly="True"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavFinance" Style="{StaticResource NavButton}" GroupName="nav" Tag="finance" Checked="Nav_Checked" HorizontalContentAlignment="Stretch" local:Ui.CompactTip="Finanças">
                            <DockPanel>
                                <TextBlock x:Name="CountFinance" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" local:Ui.WideOnly="True"
                                           ToolTip="{local:Tr 'Lançamentos pendentes vencidos ou que vencem hoje'}"/>
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Data="{StaticResource I.Wallet}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{local:Tr 'Finanças'}" local:Ui.WideOnly="True"/>
                                </StackPanel>
                            </DockPanel>
                        </RadioButton>
                        <!-- shown only when Configurações › Conteúdo is on (MainWindow.ApplyContentPanelSetting) -->
                        <RadioButton x:Name="NavContent" Style="{StaticResource NavButton}" GroupName="nav" Tag="content" Checked="Nav_Checked" HorizontalContentAlignment="Stretch" local:Ui.CompactTip="Conteúdo" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{StaticResource I.Video}" Margin="0,0,10,0"/>
                                <TextBlock Text="{local:Tr 'Conteúdo'}" local:Ui.WideOnly="True"/>
                            </StackPanel>
                        </RadioButton>
                        <Border Height="1" Background="{StaticResource Line}" Margin="4,10,4,10"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="nav" Tag="settings" Checked="Nav_Checked" HorizontalContentAlignment="Stretch" local:Ui.CompactTip="Configurações">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{StaticResource I.Settings}" Margin="0,0,10,0"/>
                                <TextBlock Text="{local:Tr 'Configurações'}" local:Ui.WideOnly="True"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- drag the sidebar's edge to resize it (open state only) -->
            <GridSplitter x:Name="SideSplitter" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="7" Margin="0,0,-3,0"
                          ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" Panel.ZIndex="10" Focusable="False"
                          Cursor="SizeWE" WindowChrome.IsHitTestVisibleInChrome="True" DragCompleted="SideSplitter_DragCompleted"
                          ToolTip="{local:Tr 'Arraste para ajustar a largura'}">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border x:Name="line" Width="2" HorizontalAlignment="Center" local:Motion.Background="Transparent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="line" Property="local:Motion.Background" Value="{StaticResource SplitterHover}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="line" Property="local:Motion.Background" Value="{StaticResource SplitterDrag}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- ================= Content ================= -->
            <Grid Grid.Column="1" Style="{StaticResource ContentArea}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- theme panel behind the window buttons, header and body (Violet Aero: light glass; classic: nothing) -->
                <ContentControl Grid.RowSpan="3" Style="{StaticResource ContentPanel}"/>

                <!-- window buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource ChromeButton}" Click="Min_Click" ToolTip="{local:Tr 'Minimizar'}">
                        <local:Icon Data="{StaticResource I.Minus}" Width="14" Height="14" Thickness="1.6"/>
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" Click="Max_Click" ToolTip="{local:Tr 'Maximizar'}">
                        <local:Icon x:Name="MaxIcon" Data="{StaticResource I.Max}" Width="12" Height="12" Thickness="1.8"/>
                    </Button>
                    <Button Style="{StaticResource CloseChromeButton}" Click="Close_Click" ToolTip="{local:Tr 'Fechar'}">
                        <local:Icon Data="{StaticResource I.X}" Width="14" Height="14" Thickness="1.6"/>
                    </Button>
                </StackPanel>

                <!-- page header + toolbar -->
                <StackPanel x:Name="PageHead" Grid.Row="1" Margin="32,0,32,14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnNewNote" Style="{StaticResource SecondaryButton}" Click="NewNote_Click" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Data="{StaticResource I.Plus}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{local:Tr 'Nova nota'}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnNewTask" Style="{StaticResource PrimaryButton}" Click="NewTask_Click" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Data="{StaticResource I.Plus}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{local:Tr 'Nova tarefa'}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnNewTx" Style="{StaticResource PrimaryButton}" Click="NewTx_Click" Margin="8,0,0,0" Visibility="Collapsed"
                                    ToolTip="{local:Tr 'Novo lançamento (Ctrl+N)'}">
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Data="{StaticResource I.Plus}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{local:Tr 'Novo lançamento'}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="PageTitle" Style="{StaticResource H1}" Text="{local:Tr 'Hoje'}"/>
                            <TextBlock x:Name="PageSub" Style="{StaticResource MutedItalic}" FontSize="13" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <StackPanel x:Name="Toolbar" Margin="0,16,0,0">
                        <WrapPanel>
                            <Grid Width="260" Margin="0,0,10,8">
                                <TextBox x:Name="SearchBox" Tag="{local:Tr 'Buscar…'}" Padding="32,7,10,7" TextChanged="Search_Changed"/>
                                <local:Icon Data="{StaticResource I.Search}" Foreground="{StaticResource Text2}" Width="14" Height="14"
                                            HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False"/>
                            </Grid>
                            <Border Style="{StaticResource SegBox}" Margin="0,0,10,8" ToolTip="{local:Tr 'Separar por período'}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="GroupNone" Style="{StaticResource SegButton}" GroupName="grp" Content="{local:Tr 'Tudo'}" Tag="none" Checked="Group_Checked"/>
                                    <RadioButton x:Name="GroupWeek" Style="{StaticResource SegButton}" GroupName="grp" Content="{local:Tr 'Por semana'}" Tag="week" Checked="Group_Checked"/>
                                    <RadioButton x:Name="GroupMonth" Style="{StaticResource SegButton}" GroupName="grp" Content="{local:Tr 'Por mês'}" Tag="month" Checked="Group_Checked"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="StatusBox" Style="{StaticResource SegBox}" Margin="0,0,10,8">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="StatusPending" Style="{StaticResource SegButton}" GroupName="st" Content="{local:Tr 'Pendentes'}" Tag="0" Checked="Status_Checked" IsChecked="True"/>
                                    <RadioButton Style="{StaticResource SegButton}" GroupName="st" Content="{local:Tr 'Concluídas'}" Tag="1" Checked="Status_Checked"/>
                                    <RadioButton Style="{StaticResource SegButton}" GroupName="st" Content="{local:Tr 'Todas'}" Tag="2" Checked="Status_Checked"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                        <WrapPanel x:Name="LabelChips"/>
                    </StackPanel>
                </StackPanel>

                <!-- body -->
                <!-- clipped so the side panel's slide-in stays inside the content glass -->
                <Grid x:Name="BodyGrid" Grid.Row="2" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Today -->
                    <ScrollViewer x:Name="TodayView" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="32,0,32,32">
                            <UniformGrid Columns="4" Margin="-6,0,-6,16">
                                <Border Style="{StaticResource Card}" Margin="6,0">
                                    <StackPanel>
                                        <TextBlock Text="{local:Tr 'Pendentes hoje'}" Style="{StaticResource Muted}"/>
                                        <TextBlock x:Name="StatToday" Style="{StaticResource BigNumber}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="6,0">
                                    <StackPanel>
                                        <TextBlock Text="{local:Tr 'Horas planejadas hoje'}" Style="{StaticResource Muted}"/>
                                        <TextBlock x:Name="StatTodayHours" Style="{StaticResource BigNumber}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="6,0">
                                    <StackPanel>
                                        <TextBlock Text="{local:Tr 'Horas nesta semana'}" Style="{StaticResource Muted}"/>
                                        <TextBlock x:Name="StatWeekHours" Style="{StaticResource BigNumber}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="6,0">
                                    <StackPanel>
                                        <TextBlock Text="{local:Tr 'Atrasadas'}" Style="{StaticResource Muted}"/>
                                        <TextBlock x:Name="StatOverdue" Style="{StaticResource BigNumber}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <!-- Finanças: bills due today and the current balance (only once something was entered there) -->
                            <Border x:Name="TodayFinance" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,16" Cursor="Hand"
                                    MouseLeftButtonUp="TodayFinance_Click" ToolTip="{local:Tr 'Abrir Finanças'}" Visibility="Collapsed">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{local:Tr 'Saldo atual'}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TodayFinanceBalance" FontSize="15" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <local:Icon DockPanel.Dock="Left" Data="{StaticResource I.Wallet}" Foreground="{StaticResource Accent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TodayFinanceText" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                            <!-- quick add: "nota:"/"tarefa:" and dates turn into chips as you type -->
                            <Border x:Name="QuickBox" Margin="0,0,0,20" Background="{StaticResource FieldFill}" BorderThickness="1"
                                    local:Motion.BorderBrush="{StaticResource Line}" CornerRadius="8" Cursor="IBeam"
                                    MouseLeftButtonDown="QuickBox_MouseDown">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="local:Motion.BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel Margin="12,0,12,0">
                                    <local:Icon DockPanel.Dock="Left" Data="{StaticResource I.Plus}" Foreground="{StaticResource Accent}"
                                                VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
                                    <Border x:Name="QuickKindChip" DockPanel.Dock="Left" Visibility="Collapsed" CornerRadius="5" Padding="8,3"
                                            Margin="0,0,6,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="{local:Tr 'Clique para remover'}"
                                            MouseLeftButtonDown="QuickKindChip_MouseDown">
                                        <StackPanel Orientation="Horizontal">
                                            <local:Icon x:Name="QuickKindIcon" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="QuickKindText" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="QuickDateChip" DockPanel.Dock="Left" Visibility="Collapsed" CornerRadius="5" Padding="8,3"
                                            Margin="0,0,6,0" VerticalAlignment="Center" Background="{StaticResource ChipBg}" Cursor="Hand"
                                            ToolTip="{local:Tr 'Clique para remover a data'}" MouseLeftButtonDown="QuickDateChip_MouseDown">
                                        <StackPanel Orientation="Horizontal">
                                            <local:Icon Data="{StaticResource I.Calendar}" Width="13" Height="13" Margin="0,0,5,0"
                                                        Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="QuickDateText" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="QuickTimeChip" DockPanel.Dock="Left" Visibility="Collapsed" CornerRadius="5" Padding="8,3"
                                            Margin="0,0,6,0" VerticalAlignment="Center" Background="{StaticResource ChipBg}" Cursor="Hand"
                                            ToolTip="{local:Tr 'Clique para remover o horário'}" MouseLeftButtonDown="QuickTimeChip_MouseDown">
                                        <StackPanel Orientation="Horizontal">
                                            <local:Icon Data="{StaticResource I.Clock}" Width="13" Height="13" Margin="0,0,5,0"
                                                        Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="QuickTimeText" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBox x:Name="QuickAdd" Style="{StaticResource BareTextBox}" VerticalContentAlignment="Center" Padding="0,10"
                                             Tag="{local:Tr 'Adicionar rápido'}"
                                             PreviewKeyDown="QuickAdd_PreviewKeyDown" KeyDown="QuickAdd_KeyDown" TextChanged="QuickAdd_TextChanged"/>
                                </DockPanel>
                            </Border>
                            <ItemsControl x:Name="TodayGroups" ItemTemplate="{StaticResource RowGroup}"/>
                            <TextBlock x:Name="TodayEmpty" Text="{local:Tr 'Nada pendente por aqui. Aproveite o dia.'}"
                                       Style="{StaticResource MutedItalic}" FontSize="13" Margin="0,8,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Notes / Tasks -->
                    <ScrollViewer x:Name="ListArea" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="32,0,20,32">
                            <ItemsControl x:Name="NoteGroups" ItemTemplate="{StaticResource NoteGroup}"/>
                            <ItemsControl x:Name="TaskGroups" ItemTemplate="{StaticResource RowGroup}"/>
                            <StackPanel x:Name="ListEmpty" Visibility="Collapsed" Margin="0,40,0,0" HorizontalAlignment="Center">
                                <local:Icon x:Name="EmptyIcon" Data="{StaticResource I.Note}" Width="36" Height="36" Foreground="{StaticResource Line}" Thickness="1.5"/>
                                <TextBlock x:Name="EmptyText" Style="{StaticResource MutedItalic}" FontSize="13" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Calendar -->
                    <Grid x:Name="CalendarView" Margin="32,0,24,24" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock x:Name="CalMeta" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButton}" Padding="7" Click="CalPrev_Click" ToolTip="{local:Tr 'Mês anterior'}">
                                    <local:Icon Data="{StaticResource I.Left}"/>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Padding="7" Margin="6,0,0,0" Click="CalNext_Click" ToolTip="{local:Tr 'Próximo mês'}">
                                    <local:Icon Data="{StaticResource I.Right}"/>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Content="{local:Tr 'Hoje'}" Margin="6,0,14,0" Click="CalToday_Click"/>
                                <TextBlock x:Name="CalTitle" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                        <UniformGrid x:Name="CalDow" Grid.Row="1" Columns="7" Margin="0,0,0,6"/>
                        <UniformGrid x:Name="CalGrid" Grid.Row="2" Columns="7" Rows="6"/>
                    </Grid>

                    <!-- Finanças (its own forms panel: spans the side-panel column) -->
                    <local:FinanceView x:Name="FinanceView" Grid.ColumnSpan="2" Visibility="Collapsed"/>

                    <!-- Conteúdo (its own side panel, like Finanças) -->
                    <local:ContentView x:Name="ContentView" Grid.ColumnSpan="2" Visibility="Collapsed"/>

                    <!-- Settings -->
                    <ScrollViewer x:Name="SettingsView" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel x:Name="SettingsPanel" Margin="32,0,32,32" MaxWidth="760" HorizontalAlignment="Left">
                            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{local:Tr 'Geral'}" Style="{StaticResource H2}"/>
                                    <DockPanel Style="{StaticResource SettingRow}">
                                        <Border DockPanel.Dock="Right" Style="{StaticResource SegBox}" VerticalAlignment="Center"
                                                AutomationProperties.Name="{local:Tr 'Tema'}">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="ThemeClassic" Style="{StaticResource SegButton}" GroupName="theme" Content="{local:Tr 'Clássico'}" Tag="classic" Click="Theme_Click"/>
                                                <RadioButton x:Name="ThemeAero" Style="{StaticResource SegButton}" GroupName="theme" Content="Violet Aero" Tag="aero" Click="Theme_Click"/>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{local:Tr 'Tema'}" Style="{StaticResource SettingTitle}"/>
                                            <TextBlock Text="{local:Tr 'Visual do app. Ao trocar, o Helmet Desk reinicia sozinho para aplicar.'}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource SettingRow}">
                                        <Border DockPanel.Dock="Right" Style="{StaticResource SegBox}" VerticalAlignment="Center"
                                                AutomationProperties.Name="{local:Tr 'Idioma'}">
                                            <!-- language names are written in their own language, so anyone can find theirs -->
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="LangEnglish" Style="{StaticResource SegButton}" GroupName="lang" Content="English" Tag="en" Click="Language_Click"/>
                                                <RadioButton x:Name="LangPortuguese" Style="{StaticResource SegButton}" GroupName="lang" Content="Português (Brasil)" Tag="pt-BR" Click="Language_Click"/>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{local:Tr 'Idioma'}" Style="{StaticResource SettingTitle}"/>
                                            <TextBlock Text="{local:Tr 'Idioma da interface. Ao trocar, o Helmet Desk reinicia sozinho para aplicar.'}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource SettingRow}">
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" Click="StartupToggle_Click" VerticalAlignment="Center"/>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{local:Tr 'Iniciar com o Windows'}" Style="{StaticResource SettingTitle}"/>
                                            <TextBlock Text="{local:Tr 'Abre o Helmet Desk automaticamente quando você entra no Windows.'}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource SettingRow}">
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding StartMinimized}" VerticalAlignment="Center"/>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{local:Tr 'Iniciar minimizado na bandeja'}" Style="{StaticResource SettingTitle}"/>
                                            <TextBlock Text="{local:Tr 'Ao iniciar com o Windows, abre só os widgets e o ícone da bandeja.'}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource SettingRow}">
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding CloseToTray}" VerticalAlignment="Center"/>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{local:Tr 'Fechar para a bandeja'}" Style="{StaticResource SettingTitle}"/>
                                            <TextBlock Text="{local:Tr 'O botão fechar (X) esconde a janela e mantém o app na bandeja. Para sair, use o menu da bandeja.'}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource SettingRow}">
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding MinimizeToTray}" VerticalAlignment="Center"/>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{local:Tr 'Minimizar para a bandeja'}" Style="{StaticResource SettingTitle}"/>
                                            <TextBlock Text="{local:Tr 'Ao minimizar, a janela sai da barra de tarefas e fica só na bandeja.'}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource SettingRow}">
                                        <CheckBox x:Name="ConfirmDeleteSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ConfirmDelete}" VerticalAlignment="Center"/>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{local:Tr 'Confirmar antes de excluir'}" Style="{StaticResource SettingTitle}"/>
                                            <TextBlock Text="{local:Tr 'Pergunta se você tem certeza antes de excluir uma nota ou tarefa. Desligado, a exclusão é imediata (ainda dá para desfazer pelo aviso no rodapé).'}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource SettingRow}">
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Reminders}" VerticalAlignment="Center"/>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{local:Tr 'Lembretes de tarefas'}" Style="{StaticResource SettingTitle}"/>
                                            <TextBlock Text="{local:Tr 'Mostra uma notificação quando chega o horário de uma tarefa.'}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource SettingRow}">
                                        <CheckBox x:Name="SoundSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding SoundEffects}" VerticalAlignment="Center"/>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{local:Tr 'Efeitos sonoros'}" Style="{StaticResource SettingTitle}"/>
                                            <TextBlock Text="{local:Tr 'Toca um som ao concluir uma tarefa e outro ao concluir a última pendente.'}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource SettingRow}" IsEnabled="{Binding SoundEffects}">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider x:Name="SoundVolumeSlider" Style="{StaticResource VolumeSlider}" Width="170" Minimum="0" Maximum="100"
                                                    SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                                    Value="{Binding SoundVolume}" AutomationProperties.Name="{local:Tr 'Volume dos efeitos sonoros'}"/>
                                            <TextBlock Text="{Binding SoundVolumeText}" Width="40" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{local:Tr 'Volume dos efeitos'}" Style="{StaticResource SettingTitle}"/>
                                            <TextBlock Text="{local:Tr 'Vale para os dois sons.'}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{local:Tr 'Área de trabalho'}" Style="{StaticResource H2}"/>
                                    <DockPanel Style="{StaticResource SettingRow}">
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding TasksWidget, Mode=OneWay}" Click="TasksWidgetToggle_Click" VerticalAlignment="Center"/>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{local:Tr 'Widget de tarefas'}" Style="{StaticResource SettingTitle}"/>
                                            <TextBlock Text="{local:Tr 'Lista de tarefas pendentes fixa na área de trabalho, com adição rápida.'}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <WrapPanel Margin="0,16,0,0">
                                        <Button Style="{StaticResource SecondaryButton}" Click="NewSticky_Click" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Data="{StaticResource I.Widget}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{local:Tr 'Nova nota na área de trabalho'}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryButton}" Click="ShowWidgets_Click" Content="{local:Tr 'Mostrar todos os widgets'}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Click="AddLabel_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Data="{StaticResource I.Plus}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{local:Tr 'Nova etiqueta'}"/>
                                            </StackPanel>
                                        </Button>
                                        <StackPanel>
                                            <TextBlock Text="{local:Tr 'Etiquetas de cor'}" Style="{StaticResource H2}"/>
                                            <TextBlock Text="{local:Tr 'Dê nome às cores usadas para diferenciar notas e tarefas.'}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <ItemsControl x:Name="LabelsEditor" Margin="0,14,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="14" Height="14" Fill="{Binding Brush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="{local:Tr 'Nome da etiqueta'}" VerticalAlignment="Center"/>
                                                    <ListBox Grid.Column="2" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource SwatchItem}"
                                                             ItemsSource="{x:Static local:Palette.LabelColors}" SelectedItem="{Binding Color}"
                                                             Margin="14,6,0,0" VerticalAlignment="Center">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Ellipse Fill="{Binding Converter={StaticResource HexBrush}}"/>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <Button Grid.Column="3" Style="{StaticResource DangerGhost}" Padding="7" Click="DeleteLabel_Click" ToolTip="{local:Tr 'Remover etiqueta'}" VerticalAlignment="Center">
                                                        <local:Icon Data="{StaticResource I.Trash}" Width="14" Height="14"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{local:Tr 'Finanças'}" Style="{StaticResource H2}"/>
                                    <DockPanel Style="{StaticResource SettingRow}">
                                        <Border DockPanel.Dock="Right" Style="{StaticResource SegBox}" VerticalAlignment="Center"
                                                AutomationProperties.Name="{local:Tr 'Moeda'}">
                                            <!-- one button per Money.Currencies entry, built in MainWindow.BuildCurrencyChoice -->
                                            <StackPanel x:Name="CurrencyChoice" Orientation="Horizontal"/>
                                        </Border>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{local:Tr 'Moeda'}" Style="{StaticResource SettingTitle}"/>
                                            <TextBlock Text="{local:Tr 'Símbolo usado nos valores da aba Finanças. Trocar a moeda não converte os valores já lançados.'}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{local:Tr 'Conteúdo'}" Style="{StaticResource H2}"/>
                                    <DockPanel Style="{StaticResource SettingRow}">
                                        <CheckBox x:Name="ContentPanelSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ContentPanel}" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{local:Tr 'Mostrar o painel Conteúdo'}"/>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{local:Tr 'Mostrar o painel Conteúdo'}" Style="{StaticResource SettingTitle}"/>
                                            <TextBlock Text="{local:Tr 'Esteira de produção para redes sociais, da ideia à publicação. Ao desligar, o painel sai da barra lateral e seus conteúdos continuam guardados.'}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{local:Tr 'Dados'}" Style="{StaticResource H2}"/>
                                    <TextBlock Text="{local:Tr 'Tudo fica salvo automaticamente neste computador:'}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="DataPath" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Style="{StaticResource SecondaryButton}" Click="OpenDataFolder_Click" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Data="{StaticResource I.Folder}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{local:Tr 'Abrir pasta de dados'}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ExportBtn" Style="{StaticResource SecondaryButton}" Click="ExportBackup_Click" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Data="{StaticResource I.Upload}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{local:Tr 'Exportar backup'}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ImportBtn" Style="{StaticResource SecondaryButton}" Click="ImportBackup_Click" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Data="{StaticResource I.Download}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{local:Tr 'Importar backup'}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ClearCacheBtn" Style="{StaticResource SecondaryButton}" Click="ClearCache_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Data="{StaticResource I.Trash}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{local:Tr 'Limpar cache'}"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <TextBlock Text="{local:Tr 'O backup é um arquivo .zip com suas notas, tarefas, etiquetas, finanças, conteúdos e configurações. Ao importar, os dados atuais são substituídos (uma cópia de segurança é guardada antes).'}"
                                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    <!-- progress of export/import -->
                                    <StackPanel x:Name="BackupStatus" Margin="0,12,0,0" Visibility="Collapsed">
                                        <TextBlock x:Name="BackupStatusText" Style="{StaticResource Muted}"/>
                                        <Border Height="4" CornerRadius="2" Background="{StaticResource Elevated}" Margin="0,6,0,0" MaxWidth="320" HorizontalAlignment="Left" Width="320">
                                            <Border x:Name="BackupBar" CornerRadius="2" Background="{StaticResource Primary}" HorizontalAlignment="Left" Width="0"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{local:Tr 'Suporte'}" Style="{StaticResource H2}"/>
                                    <TextBlock Text="{local:Tr 'Encontrou um erro? Descreva o que aconteceu e o Helmet Desk monta um relatório com as informações técnicas. Você vê tudo antes de enviar.'}"
                                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button x:Name="ReportBtn" Style="{StaticResource SecondaryButton}" Click="ReportBug_Click" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Data="{StaticResource I.Bug}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{local:Tr 'Reportar problema'}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryButton}" Click="OpenLogs_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Data="{StaticResource I.Folder}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{local:Tr 'Abrir pasta de logs'}"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{local:Tr 'Atualizações'}" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="UpdateVersionText" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button x:Name="CheckUpdatesBtn" Style="{StaticResource SecondaryButton}" Click="CheckUpdates_Click" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Data="{StaticResource I.Repeat}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{local:Tr 'Verificar atualizações'}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ApplyUpdateBtn" Style="{StaticResource PrimaryButton}" Click="ApplyUpdate_Click" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Data="{StaticResource I.Download}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{local:Tr 'Reiniciar e atualizar'}"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                            <!-- version filled in by MainWindow.Updates.cs (the real installed version) -->
                            <TextBlock x:Name="AboutFooter" Text="{local:Tr 'Helmet Desk · identidade Violet Terminal'}" Style="{StaticResource Muted}" Margin="2,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Side panel ===== -->
                    <Border x:Name="SidePanel" Grid.Column="1" Width="390" Style="{StaticResource EditorPanel}" Visibility="Collapsed"
                            PreviewKeyDown="SidePanel_PreviewKeyDown" AllowDrop="True" DragOver="SidePanel_DragOver" Drop="SidePanel_Drop">
                        <Grid>
                            <!-- Day panel (calendar) -->
                            <DockPanel x:Name="DayPanel" Margin="20,18,20,16">
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock x:Name="DayTitle" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="DayMeta" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,14">
                                        <Button Style="{StaticResource PrimaryButton}" Click="DayNewTask_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Data="{StaticResource I.Plus}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{local:Tr 'Tarefa'}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryButton}" Click="DayNewNote_Click" Margin="8,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Data="{StaticResource I.Plus}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{local:Tr 'Nota'}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <ScrollViewer x:Name="DayScroll" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <ItemsControl x:Name="DayItems" ItemTemplate="{StaticResource ItemRow}"/>
                                        <TextBlock x:Name="DayEmpty" Text="{local:Tr 'Nada marcado para este dia.'}" Style="{StaticResource MutedItalic}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>

                            <!-- ===== Viewer (read mode) ===== -->
                            <DockPanel x:Name="Viewer" Background="{StaticResource Surface}" Visibility="Collapsed">
                                <DockPanel DockPanel.Dock="Top" Margin="24,14,12,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}" Click="EditorPin_Click" ToolTip="{local:Tr 'Fixar na área de trabalho'}">
                                            <local:Icon Data="{StaticResource I.Pin}"/>
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Click="EditorClose_Click" ToolTip="{local:Tr 'Fechar (Esc)'}">
                                            <local:Icon Data="{StaticResource I.X}"/>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="{Binding LabelBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Style="{StaticResource Muted}" FontSize="12.5">
                                            <Run Text="{Binding KindName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding LabelName, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>

                                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,12">
                                    <DockPanel>
                                        <Button x:Name="ViewEditBtn" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="EditMode_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Data="{StaticResource I.Edit}" Width="14" Height="14" Margin="0,0,8,0"/>
                                                <TextBlock Text="{local:Tr 'Editar'}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource DangerGhost}" HorizontalAlignment="Left" Click="EditorDelete_Click" ToolTip="{local:Tr 'Excluir'}">
                                            <local:Icon Data="{StaticResource I.Trash}"/>
                                        </Button>
                                    </DockPanel>
                                </Border>

                                <ScrollViewer x:Name="ViewScroll" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="24,14,24,24">
                                        <TextBlock Text="{Binding DisplayTitle}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="28">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Done}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <WrapPanel Margin="0,10,0,0" TextElement.Foreground="{StaticResource Text2}" TextElement.FontSize="12.5">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,16,4" Visibility="{Binding HasDate, Converter={StaticResource Vis}}">
                                                <local:Icon Data="{StaticResource I.Calendar}" Width="13" Height="13" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding DateText}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,16,4" Visibility="{Binding HasEstimate, Converter={StaticResource Vis}}">
                                                <local:Icon Data="{StaticResource I.Clock}" Width="13" Height="13" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding EstimateDisplay}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,16,4" Visibility="{Binding HasPriority, Converter={StaticResource Vis}}">
                                                <local:Icon Data="{StaticResource I.Flag}" Width="13" Height="13" Margin="0,0,6,0" Foreground="{Binding PriorityBrush}"/>
                                                <TextBlock Text="{Binding PriorityText}"/>
                                            </StackPanel>
                                        </WrapPanel>

                                        <CheckBox Style="{StaticResource TaskCheck}" IsChecked="{Binding Done}" Content="{local:Tr 'Concluída'}" Margin="0,14,0,0"
                                                  Visibility="{Binding IsTask, Converter={StaticResource Vis}}"/>

                                        <TextBlock local:LinkText.Source="{Binding Body}" TextWrapping="Wrap" FontSize="14" LineHeight="22" Margin="0,20,0,0"
                                                   Visibility="{Binding HasPreview, Converter={StaticResource Vis}}"/>

                                        <StackPanel Margin="0,20,0,0" Visibility="{Binding HasChecklist, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding ChecklistText}" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding Checklist}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding Done}" Margin="0,5" VerticalContentAlignment="Top">
                                                            <TextBlock x:Name="t" Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,0"/>
                                                        </CheckBox>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Done}" Value="True">
                                                                <Setter TargetName="t" Property="TextDecorations" Value="Strikethrough"/>
                                                                <Setter TargetName="t" Property="Foreground" Value="{StaticResource Text2}"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel x:Name="ViewAttach" Margin="0,22,0,0"/>

                                        <TextBlock x:Name="ViewEmpty" Text="{local:Tr 'Nada escrito ainda. Clique em Editar para adicionar conteúdo.'}"
                                                   Style="{StaticResource MutedItalic}" FontSize="13" Margin="0,20,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>

                            <!-- ===== Editor (edit mode) ===== -->
                            <DockPanel x:Name="Editor" Background="{StaticResource Surface}" Visibility="Collapsed">
                                <DockPanel DockPanel.Dock="Top" Margin="24,14,12,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="EditorClose_Click" ToolTip="{local:Tr 'Fechar (Esc)'}">
                                        <local:Icon Data="{StaticResource I.X}"/>
                                    </Button>
                                    <TextBlock x:Name="EditorHeader" Style="{StaticResource Muted}" FontSize="12.5" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,12">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="ViewMode_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Data="{StaticResource I.Check}" Width="14" Height="14" Margin="0,0,8,0"/>
                                                <TextBlock Text="{local:Tr 'Concluir'}"/>
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource IconButton}" Click="Duplicate_Click" ToolTip="{local:Tr 'Duplicar'}">
                                                <local:Icon Data="{StaticResource I.Copy}"/>
                                            </Button>
                                            <Button x:Name="ConvertBtn" Style="{StaticResource IconButton}" Click="Convert_Click" Margin="2,0,0,0">
                                                <local:Icon Data="{StaticResource I.Swap}"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Click="EditorPin_Click" ToolTip="{local:Tr 'Fixar na área de trabalho'}" Margin="2,0,0,0">
                                                <local:Icon Data="{StaticResource I.Pin}"/>
                                            </Button>
                                            <Button Style="{StaticResource DangerGhost}" Padding="6" Click="EditorDelete_Click" ToolTip="{local:Tr 'Excluir'}" Margin="2,0,0,0">
                                                <local:Icon Data="{StaticResource I.Trash}"/>
                                            </Button>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <ScrollViewer x:Name="EdScroll" VerticalScrollBarVisibility="Auto" Background="Transparent">
                                    <StackPanel Margin="24,10,24,24">
                                        <TextBox x:Name="EdTitle" Style="{StaticResource BareTextBox}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"
                                                 Tag="{local:Tr 'Título'}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>

                                        <!-- properties -->
                                        <StackPanel Margin="0,16,0,0" TextElement.FontSize="13">
                                            <DockPanel Style="{StaticResource PropRow}">
                                                <StackPanel Style="{StaticResource PropLabel}">
                                                    <local:Icon Data="{StaticResource I.Tag}" Width="14" Height="14" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{local:Tr 'Etiqueta'}"/>
                                                </StackPanel>
                                                <ListBox x:Name="EdLabels" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource SwatchItem}"
                                                         SelectedValuePath="Id" SelectedValue="{Binding LabelId}" Margin="2,6,0,0">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Ellipse Fill="{Binding Brush}" ToolTip="{Binding Name}"/>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource PropRow}">
                                                <StackPanel Style="{StaticResource PropLabel}">
                                                    <local:Icon Data="{StaticResource I.Calendar}" Width="14" Height="14" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{local:Tr 'Data'}"/>
                                                </StackPanel>
                                                <local:DateField SelectedDate="{Binding Date}" Ghost="True" Width="170" HorizontalAlignment="Left"/>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource PropRow}">
                                                <StackPanel Style="{StaticResource PropLabel}">
                                                    <local:Icon Data="{StaticResource I.Clock}" Width="14" Height="14" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{local:Tr 'Horário'}"/>
                                                </StackPanel>
                                                <TextBox Style="{StaticResource GhostTextBox}" Text="{Binding TimeText, UpdateSourceTrigger=LostFocus}"
                                                         Tag="hh:mm" Width="170" HorizontalAlignment="Left" KeyDown="CommitOnEnter"/>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource PropRow}" Visibility="{Binding IsTask, Converter={StaticResource Vis}}">
                                                <StackPanel Style="{StaticResource PropLabel}">
                                                    <local:Icon Data="{StaticResource I.Hourglass}" Width="14" Height="14" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{local:Tr 'Estimativa'}"/>
                                                </StackPanel>
                                                <TextBox Style="{StaticResource GhostTextBox}" Text="{Binding EstimateText, UpdateSourceTrigger=LostFocus}"
                                                         Tag="{local:Tr 'ex.: 1h30, 45min'}" Width="170" HorizontalAlignment="Left" KeyDown="CommitOnEnter"
                                                         ToolTip="{local:Tr 'Aceita 1:30, 1h30, 45min, 1,5 ou 2 (horas)'}"/>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource PropRow}" Visibility="{Binding IsTask, Converter={StaticResource Vis}}">
                                                <StackPanel Style="{StaticResource PropLabel}">
                                                    <local:Icon Data="{StaticResource I.Flag}" Width="14" Height="14" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{local:Tr 'Prioridade'}"/>
                                                </StackPanel>
                                                <ListBox Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource SegItem}" SelectedIndex="{Binding Priority}"
                                                         HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <ListBox.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ListBox.ItemsPanel>
                                                    <local:TrExtension Text="Nenhuma"/>
                                                    <local:TrExtension Text="Baixa"/>
                                                    <local:TrExtension Text="Média"/>
                                                    <local:TrExtension Text="Alta"/>
                                                </ListBox>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource PropRow}" Visibility="{Binding IsTask, Converter={StaticResource Vis}}">
                                                <StackPanel Style="{StaticResource PropLabel}">
                                                    <local:Icon Data="{StaticResource I.Check2}" Width="14" Height="14" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{local:Tr 'Status'}"/>
                                                </StackPanel>
                                                <CheckBox Style="{StaticResource TaskCheck}" IsChecked="{Binding Done}" Content="{local:Tr 'Concluída'}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </StackPanel>

                                        <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,16"/>

                                        <!-- description: plain text where pasted links become chips (LinkBox) -->
                                        <Grid>
                                            <TextBlock Text="{local:Tr 'Escreva aqui…'}" Foreground="{StaticResource Text2}" Opacity="0.6" FontSize="14"
                                                       Margin="2,2,0,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding IsEmpty, ElementName=EdBody, Converter={StaticResource Vis}}"/>
                                            <local:LinkBox x:Name="EdBody" Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" FontSize="14" MinHeight="90"/>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Checklist}" Margin="0,14,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid x:Name="ci" Margin="0,2" Background="Transparent">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding Done}" VerticalAlignment="Top" Margin="0,4,10,0"/>
                                                        <TextBox x:Name="t" Grid.Column="1" Style="{StaticResource BareTextBox}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                                 TextWrapping="Wrap" FontSize="14" Padding="0,3" KeyDown="CheckText_KeyDown"/>
                                                        <Button x:Name="rm" Grid.Column="2" Style="{StaticResource IconButton}" Padding="4" Click="RemoveCheck_Click"
                                                                ToolTip="{local:Tr 'Remover item'}" Visibility="Hidden" VerticalAlignment="Top">
                                                            <local:Icon Data="{StaticResource I.X}" Width="13" Height="13"/>
                                                        </Button>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <Trigger SourceName="ci" Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="rm" Property="Visibility" Value="Visible"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding Done}" Value="True">
                                                            <Setter TargetName="t" Property="TextDecorations" Value="Strikethrough"/>
                                                            <Setter TargetName="t" Property="Foreground" Value="{StaticResource Text2}"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid Margin="0,4,0,0">
                                            <TextBox x:Name="NewCheck" Style="{StaticResource BareTextBox}" Tag="{local:Tr 'Adicionar item à checklist'}" FontSize="14"
                                                     Padding="28,4,0,4" KeyDown="NewCheck_KeyDown"/>
                                            <local:Icon Data="{StaticResource I.Plus}" Foreground="{StaticResource Text2}" Width="16" Height="16"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" IsHitTestVisible="False"/>
                                        </Grid>

                                        <!-- attachments (notes): built in MainWindow.Attachments.cs -->
                                        <StackPanel x:Name="EdAttach" Margin="0,24,0,0"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- Snackbar -->
                    <Border x:Name="Snack" Grid.ColumnSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20"
                            Background="{StaticResource Elevated}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10"
                            Padding="16,8,8,8" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SnackText" VerticalAlignment="Center"/>
                            <Button x:Name="SnackAction" Style="{StaticResource GhostButton}" Foreground="{StaticResource Accent}" Margin="12,0,0,0" Click="SnackAction_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===== Confirmation dialog (delete, import, messages) ===== -->
            <Grid x:Name="DialogLayer" Grid.ColumnSpan="2" Visibility="Collapsed">
                <Border x:Name="DialogScrim" Background="{StaticResource Scrim}" MouseLeftButtonDown="DialogScrim_Click"/>
                <Border x:Name="DialogCard" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12"
                        Padding="22,20,22,18" RenderTransformOrigin="0.5,0.5"
                        KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
                        AutomationProperties.Name="{local:Tr 'Confirmar exclusão'}">
                    <StackPanel>
                        <DockPanel>
                            <Border x:Name="DialogIconBg" DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="18" Background="{StaticResource DangerSoft}" Margin="0,0,14,0" VerticalAlignment="Top">
                                <local:Icon x:Name="DialogIcon" Data="{StaticResource I.Trash}" Foreground="{StaticResource Danger}" Width="17" Height="17"/>
                            </Border>
                            <StackPanel>
                                <TextBlock x:Name="DialogTitle" Style="{StaticResource H2}" FontSize="17"/>
                                <TextBlock x:Name="DialogText" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19"/>
                            </StackPanel>
                        </DockPanel>
                        <CheckBox x:Name="DialogDontAsk" Margin="50,16,0,0">
                            <TextBlock x:Name="DialogCheckText" Text="{local:Tr 'Não perguntar novamente'}" FontSize="12.5" Foreground="{StaticResource Text2}" TextWrapping="Wrap"/>
                        </CheckBox>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button x:Name="DialogCancel" Style="{StaticResource SecondaryButton}" Content="{local:Tr 'Cancelar'}" Click="DialogCancel_Click"/>
                            <Button x:Name="DialogConfirm" Style="{StaticResource DangerButton}" Content="{local:Tr 'Excluir'}" Margin="8,0,0,0" Click="DialogConfirm_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
