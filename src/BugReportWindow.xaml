<Window x:Class="HelmetDesk.BugReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HelmetDesk"
        Title="Reportar problema" Width="560" Height="640" MinWidth="440" MinHeight="480"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource DialogWindowBg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Icon="Assets/icon.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource WindowRim}" BorderThickness="1">
        <DockPanel>
            <!-- title bar -->
            <DockPanel DockPanel.Dock="Top" Height="44" Margin="20,0,8,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Padding="6" Click="Cancel_Click" ToolTip="Fechar"
                        WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center">
                    <local:Icon Data="{StaticResource I.X}" Width="14" Height="14"/>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <local:Icon Data="{StaticResource I.Bug}" Foreground="{StaticResource Accent}" Width="16" Height="16" Margin="0,0,10,0"/>
                    <TextBlock x:Name="Heading" Text="Reportar problema" FontSize="15" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>

            <!-- buttons -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BackBtn" Style="{StaticResource SecondaryButton}" Content="Cancelar" Click="Back_Click"/>
                        <Button x:Name="NextBtn" Style="{StaticResource PrimaryButton}" Content="Revisar" Margin="8,0,0,0" Click="Next_Click" IsDefault="False"/>
                    </StackPanel>
                    <TextBlock x:Name="Status" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                </DockPanel>
            </Border>

            <Grid>
                <!-- step 1: the form -->
                <ScrollViewer x:Name="FormPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,6,20,20">
                        <TextBlock Text="Conte o que aconteceu. Antes de qualquer coisa sair do seu computador, você vê exatamente o que será enviado."
                                   Style="{StaticResource Muted}" TextWrapping="Wrap"/>

                        <TextBlock Text="Título" FontWeight="SemiBold" Margin="0,18,0,6"/>
                        <TextBox x:Name="TitleBox" Tag="Ex.: o widget de tarefas some ao reiniciar" MaxLength="140"/>

                        <TextBlock Text="Descrição" FontWeight="SemiBold" Margin="0,16,0,6"/>
                        <TextBox x:Name="DescBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" MaxLength="8000"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                 Tag="O que você fez, o que esperava e o que aconteceu."/>

                        <TextBlock Text="E-mail para contato (opcional)" FontWeight="SemiBold" Margin="0,16,0,6"/>
                        <TextBox x:Name="EmailBox" Tag="voce@exemplo.com" MaxLength="200"/>

                        <CheckBox x:Name="LogsCheck" IsChecked="True" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Incluir logs técnicos"/>
                                <TextBlock Text="Versão do app e do Windows, idioma e as últimas linhas do registro de erros. Não inclui suas notas."
                                           Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="DataCheck" IsChecked="False" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Incluir meus dados (notas e tarefas)"/>
                                <TextBlock Text="Só marque se o problema depender do conteúdo. Seus dados vão anexados ao relatório."
                                           Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </CheckBox>

                        <Border x:Name="CrashBox" Visibility="Collapsed" Margin="0,18,0,0" Padding="12,10" CornerRadius="8" Background="{StaticResource DangerTint}">
                            <StackPanel>
                                <TextBlock Text="O erro capturado será incluído no relatório." FontWeight="SemiBold" Foreground="{StaticResource Danger}"/>
                                <TextBlock x:Name="CrashText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" MaxHeight="60"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- step 2: preview of exactly what goes out -->
                <DockPanel x:Name="PreviewPage" Margin="20,6,20,16" Visibility="Collapsed">
                    <TextBlock DockPanel.Dock="Top" Text="Este é o conteúdo exato do relatório. Nada é enviado sem a sua confirmação."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBox x:Name="PreviewBox" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Prévia do relatório"/>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
