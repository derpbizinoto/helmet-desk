<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:HelmetDesk">

    <!--
        Layout styles used by the screens (MainWindow, FinanceView). They are the same in every theme and only point
        at theme keys (IconButton, Pill, Line, Text2...), so ThemeManager.Apply merges this file right after the theme.
        Colors never go here: they belong to Themes/VioletAero.xaml and Themes/Legacy.xaml.
    -->

    <!-- ===== Main window ===== -->

    <!-- pencil button shown at the bottom-right of every card/row -->
    <Style x:Key="EditButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Padding" Value="6"/>
        <Setter Property="ToolTip" Value="Editar"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <!-- small pill: icon + text -->
    <Style x:Key="PillIcon" TargetType="local:Icon">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DatePill" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                <Setter Property="TextElement.Foreground" Value="{StaticResource Danger}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- group title doubles as an expand/collapse toggle -->
    <Style x:Key="GroupToggle" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="6,3,8,3"/>
        <Setter Property="Margin" Value="-6,0,0,8"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="local:Ui.Radius" Value="6"/>
        <Setter Property="local:Motion.Press" Value="False"/>
        <Setter Property="ToolTip" Value="{local:Tr 'Recolher ou expandir'}"/>
    </Style>

    <Style x:Key="SettingTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style x:Key="SettingRow" TargetType="DockPanel">
        <Setter Property="Margin" Value="0,14,0,0"/>
        <Setter Property="LastChildFill" Value="True"/>
    </Style>
    <!-- edit panel: "label | value" rows -->
    <Style x:Key="PropRow" TargetType="DockPanel">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="LastChildFill" Value="True"/>
    </Style>
    <Style x:Key="PropLabel" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Width" Value="104"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="DockPanel.Dock" Value="Left"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource Text2}"/>
    </Style>

    <!-- ===== Finanças ===== -->

    <Style x:Key="PanelHead" TargetType="DockPanel">
        <Setter Property="DockPanel.Dock" Value="Top"/>
        <Setter Property="Margin" Value="24,16,12,0"/>
    </Style>
    <Style x:Key="PanelFoot" TargetType="Border">
        <Setter Property="DockPanel.Dock" Value="Bottom"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="16,12"/>
    </Style>
    <Style x:Key="Field" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style x:Key="SumValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="23"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

</ResourceDictionary>
