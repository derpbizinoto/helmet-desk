<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:local="clr-namespace:HelmetDesk">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/HelmetDesk;component/Themes/Shared.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
        Frutiger Aero theme. Same keys as Legacy.xaml. The Helmet Desk purple (#8950D9) stays the main color;
        the Aero part is the material: glass, gloss, gel, aurora and soft light. Light glass panels carry dark
        text (#24183A); white text only sits on purple/red gel. Everything is vector, drawn here.
        Performance: blur and shadows only on big, static layers (backdrop, the two panels), cached as bitmaps;
        list rows and cards never get effects.
    -->

    <!-- slightly softer press than the classic theme -->
    <sys:Double x:Key="Motion.PressScale">0.98</sys:Double>

    <!-- ===== Purple scale (base #8950D9 unchanged) ===== -->
    <Color x:Key="P50">#F4EEFD</Color>
    <Color x:Key="P100">#E4D6F9</Color>
    <Color x:Key="P200">#C9AEF2</Color>
    <Color x:Key="P300">#A982E6</Color>
    <Color x:Key="P400">#8950D9</Color>
    <Color x:Key="P500">#6F3CBC</Color>
    <Color x:Key="P600">#522A93</Color>
    <Color x:Key="P700">#351A63</Color>
    <!-- support: lavender, soft magenta, cool aqua (aurora highlights only) -->
    <Color x:Key="C.Lavender">#D9C8F5</Color>
    <Color x:Key="C.Magenta">#E58CC9</Color>
    <Color x:Key="C.Aqua">#48CAE4</Color>

    <!-- ===== Tokens (same names as the classic theme) ===== -->
    <Color x:Key="C.Bg">#8CEFECF4</Color>          <!-- recessed tiles on glass -->
    <Color x:Key="C.Surface">#D9EEEBF4</Color>     <!-- glass rows, fields, cards -->
    <Color x:Key="C.Elevated">#FFECE7F4</Color>    <!-- hover, popups, tooltips (opaque: they float over anything) -->
    <Color x:Key="C.Border">#406F3CBC</Color>      <!-- dividers and thin borders -->
    <Color x:Key="C.Primary">#8950D9</Color>
    <Color x:Key="C.PrimaryHover">#7744BC</Color>
    <Color x:Key="C.Accent">#6A35C2</Color>        <!-- links, dates, focus: deeper purple, 5.4:1 on the glass -->
    <Color x:Key="C.Text">#24183A</Color>
    <Color x:Key="C.Text2">#574772</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource C.Bg}"/>
    <SolidColorBrush x:Key="Surface" Color="{StaticResource C.Surface}"/>
    <SolidColorBrush x:Key="Elevated" Color="{StaticResource C.Elevated}"/>
    <SolidColorBrush x:Key="Line" Color="{StaticResource C.Border}"/>
    <SolidColorBrush x:Key="Primary" Color="{StaticResource C.Primary}"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="{StaticResource C.PrimaryHover}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource C.Accent}"/>
    <SolidColorBrush x:Key="Text" Color="{StaticResource C.Text}"/>
    <SolidColorBrush x:Key="Text2" Color="{StaticResource C.Text2}"/>
    <!-- status colors darkened for light glass (all >= 4.5:1 on white) -->
    <SolidColorBrush x:Key="Success" Color="#13875A"/>
    <SolidColorBrush x:Key="Warning" Color="#9A5F0C"/>
    <SolidColorBrush x:Key="Danger" Color="#CC2E57"/>
    <SolidColorBrush x:Key="Info" Color="#2867C2"/>

    <Color x:Key="C.HoverLine">#A982E6</Color>
    <SolidColorBrush x:Key="HoverLine" Color="{StaticResource C.HoverLine}"/>
    <SolidColorBrush x:Key="ChipBg" Color="{StaticResource P100}"/>
    <SolidColorBrush x:Key="Scrim" Color="#8C1A0E33"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#26CC2E57"/>
    <SolidColorBrush x:Key="DangerTint" Color="#1FCC2E57"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#268950D9"/>
    <SolidColorBrush x:Key="OnPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="WindowBg" Color="#2A1052"/>
    <!-- desktop widgets and the bug report window: opaque frosted glass (a shine band on top, greyish lavender below) -->
    <LinearGradientBrush x:Key="WidgetWindowBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF7F5FA" Offset="0"/>
        <GradientStop Color="#FFEDE9F3" Offset="0.08"/>
        <GradientStop Color="#FFE6E1ED" Offset="0.5"/>
        <GradientStop Color="#FFDCD6E6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DialogWindowBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF5F3F9" Offset="0"/>
        <GradientStop Color="#FFE9E5F0" Offset="0.12"/>
        <GradientStop Color="#FFDFD9E9" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WindowRim" Color="#9479C4"/>
    <SolidColorBrush x:Key="OverdueLine" Color="#E58FA5"/>
    <Color x:Key="Tray.Back">#F1EEF6</Color>
    <Color x:Key="Tray.Line">#C9BDDF</Color>
    <Color x:Key="Tray.Text">#24183A</Color>

    <!-- selected item (Leopard/Vista style): light purple gloss, split highlight -->
    <LinearGradientBrush x:Key="NavSelected" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF3ECFD" Offset="0"/>
        <GradientStop Color="#FFE0CEF9" Offset="0.48"/>
        <GradientStop Color="#FFCBB0F4" Offset="0.5"/>
        <GradientStop Color="#FFDAC6F8" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassHover" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="GlassHoverRim" Color="#F2FFFFFF"/>

    <!-- ===== Gel (buttons, checks): light on top, saturated below; the white shine is a separate layer ===== -->
    <LinearGradientBrush x:Key="GelPurple" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A97CEB" Offset="0"/>
        <GradientStop Color="#8950D9" Offset="0.55"/>
        <GradientStop Color="#6A34C2" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GelPurpleHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B58DF0" Offset="0"/>
        <GradientStop Color="#955FE0" Offset="0.55"/>
        <GradientStop Color="#7440CC" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GelPurpleEdge" Color="#4A2290"/>
    <LinearGradientBrush x:Key="GelRed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EE7690" Offset="0"/>
        <GradientStop Color="#D63A5E" Offset="0.55"/>
        <GradientStop Color="#B21F40" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GelRedEdge" Color="#7A1430"/>
    <LinearGradientBrush x:Key="GelGlass" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFAF9FC" Offset="0"/>
        <GradientStop Color="#FFEAE5F2" Offset="0.55"/>
        <GradientStop Color="#FFD3C6EA" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GelGlassHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#FFF0ECF6" Offset="0.55"/>
        <GradientStop Color="#FFDCD0F0" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GelGlassEdge" Color="#9479C4"/>
    <!-- the shine on every gel shape -->
    <LinearGradientBrush x:Key="GelShine" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C8FFFFFF" Offset="0"/>
        <GradientStop Color="#33FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <!-- window buttons: small glass capsules over the aurora -->
    <LinearGradientBrush x:Key="ChromeGlass" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C8FFFFFF" Offset="0"/>
        <GradientStop Color="#80F1E8FD" Offset="0.5"/>
        <GradientStop Color="#99E1D2F8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ChromeGlassHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2FFFFFF" Offset="0"/>
        <GradientStop Color="#CCF5EEFE" Offset="0.5"/>
        <GradientStop Color="#E6E9DCFB" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===== Glass panels ===== -->
    <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E0E9E6EF" Offset="0"/>
        <GradientStop Color="#D1DCD7E6" Offset="1"/>
    </LinearGradientBrush>
    <!-- the content panel holds most of the reading: a bit more opaque -->
    <LinearGradientBrush x:Key="GlassFillStrong" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EDE6E3EC" Offset="0"/>
        <GradientStop Color="#E6DAD5E4" Offset="1"/>
    </LinearGradientBrush>
    <!-- outer rim: bright on top, fading down (the Aero double edge, outer half) -->
    <LinearGradientBrush x:Key="GlassRim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2FFFFFF" Offset="0"/>
        <GradientStop Color="#80FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassRimInner" Color="#33351A63"/>
    <!-- specular highlight across the top of a panel -->
    <LinearGradientBrush x:Key="GlassSpecular" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#73FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2F4F2F8" Offset="0"/>
        <GradientStop Color="#EBE6E2EE" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardRim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#80B9A3DE" Offset="1"/>
    </LinearGradientBrush>

    <!-- glass panel: fill + specular top + inner dark rim + bright outer rim with a soft purple shadow -->
    <ControlTemplate x:Key="GlassPanelTemplate" TargetType="ContentControl">
        <Grid>
            <Border CornerRadius="10" BorderBrush="{StaticResource GlassRim}" BorderThickness="1" CacheMode="BitmapCache">
                <Border.Effect>
                    <DropShadowEffect Color="#24083F" BlurRadius="22" ShadowDepth="3" Direction="270" Opacity="0.55"/>
                </Border.Effect>
            </Border>
            <Border CornerRadius="10" Background="{TemplateBinding Background}"/>
            <Border CornerRadius="10,10,0,0" Height="56" VerticalAlignment="Top" Margin="1,1,1,0" Background="{StaticResource GlassSpecular}"/>
            <Border CornerRadius="9" Margin="1" BorderBrush="{StaticResource GlassRimInner}" BorderThickness="1"/>
            <Border CornerRadius="10" BorderBrush="{StaticResource GlassRim}" BorderThickness="1"/>
        </Grid>
    </ControlTemplate>

    <!-- ===== Window layers ===== -->
    <!-- twilight backdrop: deep purple at the top to lavender below, aurora ribbons, bokeh orbs, title glass strip -->
    <Style x:Key="AppBackdrop" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid ClipToBounds="True">
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0.25,1">
                                    <GradientStop Color="#1B0938" Offset="0"/>
                                    <GradientStop Color="#3A1872" Offset="0.38"/>
                                    <GradientStop Color="#6A3DB8" Offset="0.72"/>
                                    <GradientStop Color="#B79BE8" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- aurora: wide blurred ribbons, rendered once at half scale and cached; drifts slowly -->
                        <Viewbox Stretch="UniformToFill" Margin="-80" local:ThemeManager.Drift="48" local:ThemeManager.DriftBy="70,22">
                            <Viewbox.CacheMode>
                                <BitmapCache RenderAtScale="0.5"/>
                            </Viewbox.CacheMode>
                            <Canvas Width="1600" Height="1000">
                                <Canvas.Effect>
                                    <BlurEffect Radius="70" KernelType="Gaussian" RenderingBias="Performance"/>
                                </Canvas.Effect>
                                <Path Opacity="0.55" Data="M-100,640 C300,430 720,720 1120,500 S1640,380 1800,450 L1800,580 C1520,520 1320,640 1020,670 S300,590 -100,790 Z">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="{StaticResource P200}" Offset="0"/>
                                            <GradientStop Color="{StaticResource C.Lavender}" Offset="0.5"/>
                                            <GradientStop Color="{StaticResource C.Magenta}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>
                                <Path Opacity="0.42" Data="M-100,290 C420,170 820,430 1220,260 S1700,190 1800,230 L1800,330 C1420,330 1210,450 900,460 S220,320 -100,440 Z">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="{StaticResource C.Magenta}" Offset="0"/>
                                            <GradientStop Color="{StaticResource P300}" Offset="0.6"/>
                                            <GradientStop Color="{StaticResource C.Aqua}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>
                                <Path Opacity="0.38" Fill="#48CAE4"
                                      Data="M260,860 C640,740 1040,890 1560,740 L1560,800 C1040,940 640,800 260,930 Z"/>
                                <Ellipse Canvas.Left="1080" Canvas.Top="-120" Width="620" Height="420" Opacity="0.35" Fill="#D9C8F5"/>
                            </Canvas>
                        </Viewbox>

                        <!-- light streaks and bokeh orbs (sharp, not blurred), cached; drift slower -->
                        <Viewbox Stretch="UniformToFill" local:ThemeManager.Drift="60" local:ThemeManager.DriftBy="-30,12">
                            <Viewbox.CacheMode>
                                <BitmapCache/>
                            </Viewbox.CacheMode>
                            <Canvas Width="1600" Height="1000">
                                <Path Stroke="#59FFFFFF" StrokeThickness="2" Data="M-60,760 C420,520 960,560 1700,170"/>
                                <Path Stroke="#33FFFFFF" StrokeThickness="1" Data="M-60,800 C460,570 1000,620 1700,240"/>
                                <Path Stroke="#264CCFE6" StrokeThickness="3" Data="M-60,860 C500,660 1060,700 1700,330"/>
                                <Ellipse Canvas.Left="1270" Canvas.Top="560" Width="150" Height="150">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush GradientOrigin="0.35,0.3">
                                            <GradientStop Color="#55FFFFFF" Offset="0"/>
                                            <GradientStop Color="#14FFFFFF" Offset="0.85"/>
                                            <GradientStop Color="#40FFFFFF" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Canvas.Left="1180" Canvas.Top="720" Width="70" Height="70">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush GradientOrigin="0.35,0.3">
                                            <GradientStop Color="#66FFFFFF" Offset="0"/>
                                            <GradientStop Color="#10FFFFFF" Offset="0.85"/>
                                            <GradientStop Color="#4DFFFFFF" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Canvas.Left="140" Canvas.Top="130" Width="110" Height="110">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush GradientOrigin="0.35,0.3">
                                            <GradientStop Color="#40FFFFFF" Offset="0"/>
                                            <GradientStop Color="#0DFFFFFF" Offset="0.85"/>
                                            <GradientStop Color="#33FFFFFF" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Canvas.Left="1460" Canvas.Top="420" Width="44" Height="44">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush GradientOrigin="0.35,0.3">
                                            <GradientStop Color="#73FFFFFF" Offset="0"/>
                                            <GradientStop Color="#14C9AEF2" Offset="0.85"/>
                                            <GradientStop Color="#59FFFFFF" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Canvas.Left="760" Canvas.Top="880" Width="90" Height="90">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush GradientOrigin="0.35,0.3">
                                            <GradientStop Color="#4DFFFFFF" Offset="0"/>
                                            <GradientStop Color="#0D48CAE4" Offset="0.85"/>
                                            <GradientStop Color="#4048CAE4" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Canvas.Left="1530" Canvas.Top="80" Width="28" Height="28" Fill="#40FFFFFF"/>
                                <Ellipse Canvas.Left="60" Canvas.Top="610" Width="22" Height="22" Fill="#33FFFFFF"/>
                            </Canvas>
                        </Viewbox>

                        <!-- title bar: a strip of glass with the Vista/7 shine -->
                        <Border Height="40" VerticalAlignment="Top" BorderBrush="#40FFFFFF" BorderThickness="0,0,0,1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#40FFFFFF" Offset="0"/>
                                    <GradientStop Color="#1FFFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#0AFFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#14FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- glass behind the sidebar (the sidebar itself is then transparent) -->
    <Style x:Key="SidebarGlass" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Margin" Value="8,10,2,10"/>
        <Setter Property="Background" Value="{StaticResource GlassFill}"/>
        <Setter Property="Template" Value="{StaticResource GlassPanelTemplate}"/>
    </Style>
    <Style x:Key="SidebarPanel" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="8,10,2,10"/>
    </Style>
    <!-- the column to the right of the sidebar: inset so the aurora frames it -->
    <Style x:Key="ContentArea" TargetType="Grid">
        <Setter Property="Margin" Value="6,0,10,10"/>
    </Style>
    <Style x:Key="ContentPanel" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Background" Value="{StaticResource GlassFillStrong}"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
        <Setter Property="Template" Value="{StaticResource GlassPanelTemplate}"/>
    </Style>
    <!-- "HELMET DESK" in Geo: deep purple fill with a white glow (Vista title style), readable on the glass -->
    <Style x:Key="BrandText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="Foreground">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#5A2BAE" Offset="0"/>
                    <GradientStop Color="#2E1266" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="White" BlurRadius="8" ShadowDepth="0" Opacity="1"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Focus ===== -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="9" RadiusY="9" Stroke="{StaticResource Accent}" StrokeThickness="1.5" SnapsToDevicePixels="True">
                        <Rectangle.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                         Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Ease.Out}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Rectangle.Triggers>
                    </Rectangle>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Buttons ===== -->
    <!-- base for the flat buttons (ghost, icon, nav, segments): colors fade with Motion.*; Medium weight -->
    <Style x:Key="BtnBase" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="local:Ui.Radius" Value="8"/>
        <Setter Property="local:Motion.Press" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="b" local:Motion.Background="{TemplateBinding Background}" local:Motion.BorderBrush="{TemplateBinding BorderBrush}"
                            local:Motion.Foreground="{TemplateBinding Foreground}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding local:Ui.Radius}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- hover/press timing for the gel shapes -->
    <Storyboard x:Key="Gel.HoverIn">
        <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
        <DoubleAnimation Storyboard.TargetName="shine" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
    </Storyboard>
    <Storyboard x:Key="Gel.HoverOut">
        <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
        <DoubleAnimation Storyboard.TargetName="shine" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.2"/>
    </Storyboard>
    <Storyboard x:Key="Gel.PressIn">
        <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08"/>
        <DoubleAnimation Storyboard.TargetName="shine" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.08"/>
    </Storyboard>
    <Storyboard x:Key="Gel.PressOut">
        <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
        <DoubleAnimation Storyboard.TargetName="shine" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
    </Storyboard>

    <!-- Gel pill: Background = gel gradient, BorderBrush = dark edge. Layers: hover glow, body, inner white rim,
         shine on the top half, press shade (inverted, darker), content. Text gets a soft shadow when it is white. -->
    <ControlTemplate x:Key="GelTemplate" TargetType="ButtonBase">
        <Grid x:Name="root" SnapsToDevicePixels="True">
            <Border x:Name="glow" CornerRadius="{TemplateBinding local:Ui.Radius}" Background="{TemplateBinding Background}" Opacity="0">
                <Border.Effect>
                    <DropShadowEffect Color="#F3EBFF" BlurRadius="14" ShadowDepth="0" Opacity="1"/>
                </Border.Effect>
            </Border>
            <Border CornerRadius="{TemplateBinding local:Ui.Radius}" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
            <Border CornerRadius="{TemplateBinding local:Ui.Radius}" Margin="1" BorderBrush="#59FFFFFF" BorderThickness="1"/>
            <Grid Margin="2,2,2,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="shine" CornerRadius="{TemplateBinding local:Ui.Radius}" Background="{StaticResource GelShine}" Opacity="0.8"/>
            </Grid>
            <Border x:Name="press" CornerRadius="{TemplateBinding local:Ui.Radius}" Opacity="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#4D1A0838" Offset="0"/>
                        <GradientStop Color="#141A0838" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <ContentPresenter x:Name="cp" Margin="{TemplateBinding Padding}" RecognizesAccessKey="False"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <ContentPresenter.Effect>
                    <DropShadowEffect Color="#2A0D5C" BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.7"/>
                </ContentPresenter.Effect>
            </ContentPresenter>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Gel.HoverIn}"/></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Gel.HoverOut}"/></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Gel.PressIn}"/></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Gel.PressOut}"/></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="Tag" Value="light">
                <Setter TargetName="cp" Property="Effect" Value="{x:Null}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="root" Property="Opacity" Value="0.5"/>
                <Setter TargetName="shine" Property="Opacity" Value="0.4"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="GelButton" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="local:Ui.Radius" Value="15"/>
        <Setter Property="Template" Value="{StaticResource GelTemplate}"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GelButton}">
        <Setter Property="Background" Value="{StaticResource GelPurple}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GelPurpleEdge}"/>
        <Setter Property="Foreground" Value="{StaticResource OnPrimary}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GelPurpleHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GelButton}">
        <Setter Property="Background" Value="{StaticResource GelRed}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GelRedEdge}"/>
        <Setter Property="Foreground" Value="{StaticResource OnPrimary}"/>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource GelButton}">
        <Setter Property="Tag" Value="light"/>
        <Setter Property="Background" Value="{StaticResource GelGlass}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GelGlassEdge}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GelGlassHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- sidebar footer rows: recessed white tiles on the glass -->
    <Style x:Key="SideRowButton" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource Bg}"/>
        <Setter Property="BorderBrush" Value="#66FFFFFF"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="14,9,10,9"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="local:Ui.Radius" Value="10"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GlassHover}"/>
                <Setter Property="BorderBrush" Value="{StaticResource GlassHoverRim}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- flat buttons light up as a small glass bubble on hover -->
    <Style x:Key="GhostButton" TargetType="ButtonBase" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Foreground" Value="{StaticResource Text2}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GlassHover}"/>
                <Setter Property="BorderBrush" Value="{StaticResource GlassHoverRim}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IconButton" TargetType="ButtonBase" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Padding" Value="6"/>
        <Setter Property="local:Ui.Radius" Value="7"/>
    </Style>

    <Style x:Key="DangerGhost" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Danger}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ToggleIcon" TargetType="ToggleButton" BasedOn="{StaticResource IconButton}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                <Setter Property="Background" Value="{StaticResource NavSelected}"/>
                <Setter Property="BorderBrush" Value="#B39479C4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- window buttons: glass capsules on the title strip; close turns into red gel on hover -->
    <ControlTemplate x:Key="ChromeTemplate" TargetType="Button">
        <Grid x:Name="root" Margin="2,17,2,0" Height="22" VerticalAlignment="Top">
            <Border x:Name="glow" CornerRadius="5" Background="{TemplateBinding Background}" Opacity="0">
                <Border.Effect>
                    <DropShadowEffect Color="#F3EBFF" BlurRadius="12" ShadowDepth="0" Opacity="1"/>
                </Border.Effect>
            </Border>
            <Border CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="#99351A63" BorderThickness="1"/>
            <Border CornerRadius="4" Margin="1" BorderBrush="#80FFFFFF" BorderThickness="1"/>
            <Border x:Name="shine" CornerRadius="4,4,0,0" Margin="2,2,2,0" Height="9" VerticalAlignment="Top" Background="{StaticResource GelShine}" Opacity="0.8"/>
            <Border x:Name="press" CornerRadius="5" Background="#331A0838" Opacity="0"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Gel.HoverIn}"/></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Gel.HoverOut}"/></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Gel.PressIn}"/></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Gel.PressOut}"/></Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="{StaticResource ChromeGlass}"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="local:Motion.Press" Value="False"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template" Value="{StaticResource ChromeTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ChromeGlassHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CloseChromeButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GelRed}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NavButton" TargetType="RadioButton" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Foreground" Value="{StaticResource Text2}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GlassHover}"/>
                <Setter Property="BorderBrush" Value="{StaticResource GlassHoverRim}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
            <!-- the selected look comes from the sliding marker behind the list (MainWindow NavMarker) -->
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SegButton" TargetType="RadioButton" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Foreground" Value="{StaticResource Text2}"/>
        <Setter Property="Padding" Value="11,5"/>
        <Setter Property="local:Ui.Radius" Value="6"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource NavSelected}"/>
                <Setter Property="BorderBrush" Value="#B39479C4"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SegBox" TargetType="Border">
        <Setter Property="Background" Value="#66F4F2F8"/>
        <Setter Property="BorderBrush" Value="#CCFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="2"/>
    </Style>

    <!-- Label filter chip -->
    <Style x:Key="Chip" TargetType="RadioButton" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Foreground" Value="{StaticResource Text2}"/>
        <Setter Property="Background" Value="#66F4F2F8"/>
        <Setter Property="BorderBrush" Value="#CCFFFFFF"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="local:Ui.Radius" Value="12"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="Background" Value="{StaticResource GlassHover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource NavSelected}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== TextBox ===== -->
    <!-- white field, slightly sunk (darker top edge = inner shadow), purple glow on focus -->
    <LinearGradientBrush x:Key="FieldFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFDCD6E6" Offset="0"/>
        <GradientStop Color="#FFF1EFF5" Offset="0.18"/>
        <GradientStop Color="#FFF6F5F9" Offset="1"/>
    </LinearGradientBrush>
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource FieldFill}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="BorderBrush" Value="#A08AC4"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Primary}"/>
        <Setter Property="SelectionOpacity" Value="0.5"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="local:Ui.Radius" Value="8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" local:Motion.BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding local:Ui.Radius}" SnapsToDevicePixels="True">
                        <Grid>
                            <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{StaticResource Text2}" Opacity="0.75"
                                       Visibility="Collapsed" IsHitTestVisible="False" Margin="{TemplateBinding Padding}" Padding="2,0,0,0" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="local:Motion.BorderBrush" Value="{StaticResource HoverLine}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="local:Motion.BorderBrush" Value="{StaticResource Primary}"/>
                            <Setter TargetName="b" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#A982E6" BlurRadius="9" ShadowDepth="0" Opacity="0.9"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Borderless until hovered/focused: used in the edit panel -->
    <Style x:Key="GhostTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="8,6"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BareTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0,2"/>
        <!-- text starts at the top (next to the placeholder) and grows downward -->
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid Background="Transparent">
                        <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{StaticResource Text2}" Opacity="0.6"
                                   Visibility="Collapsed" IsHitTestVisible="False" Margin="{TemplateBinding Padding}" Padding="2,0,0,0" VerticalAlignment="Top"/>
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== CheckBox ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5"
                                local:Motion.BorderBrush="{StaticResource Text2}" local:Motion.Background="Transparent" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                SnapsToDevicePixels="True">
                            <local:Icon x:Name="mark" Data="{StaticResource I.Check}" Width="12" Height="12" Thickness="3"
                                        Foreground="#FFFFFF" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter x:Name="cp" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="cp" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="local:Motion.BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="local:Motion.Background" Value="{StaticResource GelPurple}"/>
                            <Setter TargetName="box" Property="local:Motion.BorderBrush" Value="{StaticResource Primary}"/>
                            <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Task completion check: round, drawn with the exact ring/check outlines of the
         "tarefa-concluida" animation (512x512 space) so the static state matches its last frame. -->

    <Style x:Key="TaskCheck" TargetType="CheckBox">
        <Setter Property="local:TaskCheckFx.Enabled" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Viewbox x:Name="art" Width="24" Height="24" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Canvas Width="512" Height="512">
                                <Path x:Name="ring" Data="{StaticResource G.TaskRing}" local:Motion.Fill="{StaticResource Text2}"/>
                                <Path x:Name="mark" Data="{StaticResource G.TaskCheck}" Fill="{StaticResource Text}" Visibility="Collapsed"/>
                            </Canvas>
                        </Viewbox>
                        <!-- "press" segment of the animation, played on user click (TaskCheckFx); its last frame equals the checked art -->
                        <local:LottieView x:Name="fx" Source="tarefa-concluida" StartFrame="14" EndFrame="20" Size="24"
                                          AutoPlay="False" ClearOnComplete="True" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        <ContentPresenter x:Name="cp" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="cp" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ring" Property="local:Motion.Fill" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ring" Property="local:Motion.Fill" Value="{StaticResource Primary}"/>
                            <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger SourceName="fx" Property="IsAnimating" Value="True">
                            <Setter TargetName="art" Property="Opacity" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="local:Motion.Switch" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="track" Width="38" Height="22" CornerRadius="11" local:Motion.Background="{StaticResource FieldFill}" BorderBrush="#A08AC4" BorderThickness="1" Padding="2">
                        <Ellipse x:Name="thumb" Width="16" Height="16" local:Motion.Fill="{StaticResource Text2}" HorizontalAlignment="Left"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="local:Motion.Background" Value="{StaticResource GelPurple}"/>
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="thumb" Property="local:Motion.Fill" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Selection lists (swatches / segments) ===== -->
    <Style x:Key="PlainList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SwatchItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ring" Width="28" Height="28" CornerRadius="14" BorderThickness="2" local:Motion.BorderBrush="Transparent" Padding="3">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ring" Property="local:Motion.BorderBrush" Value="{StaticResource Line}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ring" Property="local:Motion.BorderBrush" Value="{StaticResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Text2}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" CornerRadius="6" Padding="10,5" local:Motion.Background="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="local:Motion.Background" Value="{StaticResource Line}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ScrollBar ===== -->
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" CornerRadius="4" Margin="2" BorderBrush="#B38D6CC2" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F2FFFFFF" Offset="0"/>
                                <GradientStop Color="#CCE4D6F9" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{StaticResource HoverLine}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}"/>
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}"/>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}"/>
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPage}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPage}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== ToolTip ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <!-- light glass with a lilac tint -->
                    <Border BorderBrush="#B39479C4" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,4,4">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                <GradientStop Color="#FFF1E9FC" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ComboBox (Finanças: account, category, filters) ===== -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7,30,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="MaxDropDownHeight" Value="320"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="b" Background="{TemplateBinding Background}" local:Motion.BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True"/>
                        <ToggleButton Style="{StaticResource ComboToggle}" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                        <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <local:Icon Data="{StaticResource I.ChevronDown}" Width="14" Height="14" HorizontalAlignment="Right" Margin="0,0,10,0"
                                    Foreground="{StaticResource Text2}" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="4"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, ElementName=b}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{StaticResource Elevated}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    CornerRadius="10" Padding="4" Margin="0,0,8,8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="local:Motion.BorderBrush" Value="{StaticResource HoverLine}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="b" Property="local:Motion.BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Line}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Text helpers ===== -->
    <!-- big titles: Roboto Light, with a soft white glow on the glass -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.XL}"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="White" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Text2}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Text2}"/>
    </Style>
    <!-- Empty states and page subtitles: Roboto italic -->
    <Style x:Key="MutedItalic" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
        <Setter Property="FontStyle" Value="Italic"/>
    </Style>
    <!-- Big numbers: Roboto Light with aligned (tabular) digits -->
    <Style x:Key="BigNumber" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <!-- Small section caps ("HOJE"): Roboto Bold -->
    <Style x:Key="Overline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Text2}"/>
    </Style>

    <!-- cards sit on the glass panel: brighter glass, white rim on top; no shadow (they repeat) -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardFill}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardRim}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Small pill used for hours / dates -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="#1F8950D9"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource Text2}"/>
        <Setter Property="TextElement.FontSize" Value="11.5"/>
    </Style>

</ResourceDictionary>
