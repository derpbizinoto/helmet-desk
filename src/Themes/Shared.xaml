    <!-- Shared by every theme (merged by Themes/Legacy.xaml and Themes/FrutigerAero.xaml): motion, fonts, type scale, icons. No colors here. -->

    <!-- ===== Motion tokens (read by Motion.cs; every transition uses these) ===== -->
    <Duration x:Key="Motion.Fast">0:0:0.15</Duration>
    <Duration x:Key="Motion.Base">0:0:0.22</Duration>
    <Duration x:Key="Motion.Slow">0:0:0.3</Duration>
    <CubicEase x:Key="Ease.Out" EasingMode="EaseOut"/>
    <CubicEase x:Key="Ease.In" EasingMode="EaseIn"/>
    <CubicEase x:Key="Ease.Standard" EasingMode="EaseInOut"/>
    <sys:Double x:Key="Motion.ShiftSmall">8</sys:Double>
    <sys:Double x:Key="Motion.Shift">16</sys:Double>
    <sys:Double x:Key="Motion.ShiftPanel">24</sys:Double>
    <sys:Double x:Key="Motion.PressScale">0.97</sys:Double>
    <sys:Double x:Key="Motion.PopScale">0.96</sys:Double>

    <!-- ===== Fonts (Google Fonts embedded in Assets/Fonts, see tools\baixar-fontes.ps1) =====
         Roboto: the whole interface. Geo: only the app name. Segoe UI only covers glyphs Roboto lacks (emoji etc.).
         Same keys in every theme. UiFont/BrandFont are the older names, kept so nothing else had to change. -->
    <FontFamily x:Key="UiFontFamily">../Assets/Fonts/#Roboto, Segoe UI</FontFamily>
    <FontFamily x:Key="BrandFontFamily">../Assets/Fonts/#Geo, Segoe UI</FontFamily>
    <FontFamily x:Key="UiFont">../Assets/Fonts/#Roboto, Segoe UI</FontFamily>
    <FontFamily x:Key="BrandFont">../Assets/Fonts/#Geo, Segoe UI</FontFamily>

