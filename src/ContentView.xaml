<UserControl x:Class="HelmetDesk.ContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HelmetDesk"
             Foreground="{StaticResource Text}" Typography.NumeralAlignment="Tabular">
    <!--
        Painel experimental "Conteúdo" (esteira de produção). Shown only when experimental.json has "conteudo": true.
        Same pattern as FinanceView: the state and rules are in HelmetDesk.Core.Content (ContentPanelViewModel and its forms);
        the channel buttons, cards, spheres and rows are built in ContentView.xaml.cs. Data lives in conteudo.json.
    -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" SizeChanged="Scroll_SizeChanged">
            <StackPanel Margin="32,0,24,32">
                <!-- 1. header: "Novo:" one button per channel + Gerenciar canais -->
                <DockPanel Margin="0,0,0,16">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Click="ManageChannels_Click" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <local:Icon Data="{StaticResource I.Settings}" Margin="0,0,6,0"/>
                            <TextBlock Text="{local:Tr 'Gerenciar canais'}"/>
                        </StackPanel>
                    </Button>
                    <WrapPanel x:Name="NewButtons" VerticalAlignment="Center">
                        <TextBlock Text="{local:Tr 'Novo:'}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,8"/>
                    </WrapPanel>
                </DockPanel>

                <!-- 2. channel cards (filter, single selection) -->
                <WrapPanel x:Name="ChannelCards" Margin="-6,0,-6,10"/>

                <!-- 3. the esteira: one sphere per stage on a rail -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16,14,16,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <Button x:Name="AllStagesBtn" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{local:Tr 'Todas as etapas'}"
                                    Click="AllStages_Click" Visibility="Hidden"/>
                            <TextBlock Text="{local:Tr 'Etapas'}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid x:Name="Belt" Margin="0,6,0,0">
                            <!-- rail behind the spheres (row 0, centered on them) -->
                            <Border x:Name="Rail" Height="8" CornerRadius="4" VerticalAlignment="Top" Margin="0,30,0,0" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#55FFFFFF" Offset="0"/>
                                        <GradientStop Color="#338950D9" Offset="0.5"/>
                                        <GradientStop Color="#55000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <UniformGrid x:Name="Spheres" Rows="1"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. summary -->
                <TextBlock x:Name="SummaryText" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,10"/>

                <!-- 5. cards -->
                <UniformGrid x:Name="CardGrid" Columns="3" Margin="-6,0,-6,0" VerticalAlignment="Top"/>
                <StackPanel x:Name="EmptyBox" Margin="0,36,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                    <local:Icon Data="{StaticResource I.Video}" Width="36" Height="36" Foreground="{StaticResource Line}" Thickness="1.5"/>
                    <TextBlock x:Name="EmptyText" Style="{StaticResource MutedItalic}" FontSize="13" Margin="0,12,0,0" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= side panel ================= -->
        <Border x:Name="Panel" Grid.Column="1" Width="390" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="1,1,0,0" CornerRadius="12,0,0,0" Visibility="Collapsed">
            <Grid>
                <!-- ===== content item ===== -->
                <DockPanel x:Name="ItemForm" Visibility="Collapsed">
                    <DockPanel Style="{StaticResource PanelHead}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="ClosePanel_Click" ToolTip="{local:Tr 'Fechar (Esc)'}">
                            <local:Icon Data="{StaticResource I.X}"/>
                        </Button>
                        <TextBlock x:Name="ItemFormTitle" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Style="{StaticResource PanelFoot}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButton}" Content="{local:Tr 'Cancelar'}" Click="ClosePanel_Click"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="{local:Tr 'Salvar'}" Margin="8,0,0,0" Click="ItemSave_Click" ToolTip="{local:Tr 'Salvar (Enter)'}"/>
                            </StackPanel>
                            <Button x:Name="ItemDeleteBtn" Style="{StaticResource DangerGhost}" Click="ItemDelete_Click" ToolTip="{local:Tr 'Excluir'}" HorizontalAlignment="Left">
                                <local:Icon Data="{StaticResource I.Trash}"/>
                            </Button>
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,14,24,24">
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Text="{local:Tr 'Título'}" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ItemTitle" Tag="{local:Tr 'Ex.: Review do fone novo'}" PreviewKeyDown="ItemForm_KeyDown"
                                         AutomationProperties.Name="{local:Tr 'Título'}"/>
                                <TextBlock x:Name="ItemError" Foreground="{StaticResource Danger}" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Text="{local:Tr 'Canal'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ItemChannel" AutomationProperties.Name="{local:Tr 'Canal'}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Text="{local:Tr 'Etapa'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ItemStage" AutomationProperties.Name="{local:Tr 'Etapa'}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Text="{local:Tr 'Data de publicação (opcional)'}" Style="{StaticResource FieldLabel}"/>
                                <local:DateField x:Name="ItemDate"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Text="{local:Tr 'Notas'}" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ItemNotes" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{local:Tr 'Notas'}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- ===== Gerenciar canais: list ===== -->
                <DockPanel x:Name="ChannelsList" Visibility="Collapsed">
                    <DockPanel Style="{StaticResource PanelHead}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="ClosePanel_Click" ToolTip="{local:Tr 'Fechar (Esc)'}">
                            <local:Icon Data="{StaticResource I.X}"/>
                        </Button>
                        <TextBlock Text="{local:Tr 'Gerenciar canais'}" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Style="{StaticResource PanelFoot}">
                        <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="NewChannel_Click">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{StaticResource I.Plus}" Margin="0,0,6,0"/>
                                <TextBlock Text="{local:Tr 'Novo canal'}"/>
                            </StackPanel>
                        </Button>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,14,20,24">
                            <StackPanel x:Name="ChannelRows"/>
                            <TextBlock x:Name="ChannelsEmpty" Style="{StaticResource MutedItalic}" Text="{local:Tr 'Nenhum canal. Crie um para começar.'}"
                                       Margin="4,8,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- ===== Gerenciar canais: one channel ===== -->
                <DockPanel x:Name="ChannelForm" Visibility="Collapsed">
                    <DockPanel Style="{StaticResource PanelHead}">
                        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Click="ChannelBack_Click" ToolTip="{local:Tr 'Voltar'}" Margin="0,0,6,0">
                            <local:Icon Data="{StaticResource I.Left}"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="ClosePanel_Click" ToolTip="{local:Tr 'Fechar (Esc)'}">
                            <local:Icon Data="{StaticResource I.X}"/>
                        </Button>
                        <TextBlock x:Name="ChannelFormTitle" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Style="{StaticResource PanelFoot}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SecondaryButton}" Content="{local:Tr 'Cancelar'}" Click="ChannelBack_Click"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="{local:Tr 'Salvar'}" Margin="8,0,0,0" Click="ChannelSave_Click"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,14,24,24">
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Text="{local:Tr 'Nome'}" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ChannelName" Tag="{local:Tr 'Ex.: YouTube, Blog'}" PreviewKeyDown="ChannelForm_KeyDown"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Text="{local:Tr 'Seguidores'}" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ChannelFollowers" Tag="0" PreviewKeyDown="ChannelForm_KeyDown"/>
                                <TextBlock Text="{local:Tr 'Digitado à mão; atualize quando quiser.'}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Text="{local:Tr 'Cor'}" Style="{StaticResource FieldLabel}"/>
                                <WrapPanel x:Name="ChannelColors"/>
                            </StackPanel>
                            <TextBlock x:Name="ChannelError" Foreground="{StaticResource Danger}" FontSize="12" Visibility="Collapsed" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
